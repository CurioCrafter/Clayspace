 static int ui_popup_handler(bContext *C, const wmEvent *event, void *userdata)
 {
   PopupBlockHandle *menu = static_cast<PopupBlockHandle *>(userdata);
+#ifdef WITH_XR_OPENXR
+  if (!WM_xr_hand_menu_event_allowed(CTX_wm_manager(C), menu->region, event)) {
+    return WM_UI_HANDLER_CONTINUE;
+  }
+#endif
   /* we block all events, this is modal interaction,
    * except for drop events which is described below */
   int retval = WM_UI_HANDLER_BREAK;
@@ -12488,6 +12503,50 @@ void popup_handlers_remove_all(bContext *C, ListBaseT<wmEventHandler> *handlers)
   WM_event_free_ui_handler_all(C, handlers, ui_popup_handler, ui_popup_handler_remove);
 }
 
+void popup_handlers_remove_xr(bContext *C, ListBaseT<wmEventHandler> *handlers)
+{
+#ifdef WITH_XR_OPENXR
+  wmWindowManager *wm = CTX_wm_manager(C);
+  wmWindow *win = CTX_wm_window(C);
+  bScreen *screen = win ? WM_window_get_active_screen(win) : nullptr;
+  if (screen && screen->tool_tip &&
+      (WM_xr_hand_menu_region_owned(wm, screen->tool_tip->region) ||
+       WM_xr_hand_menu_region_owned(wm, screen->tool_tip->region_from)))
+  {
+    WM_tooltip_clear(C, win);
+  }
+
+  for (;;) {
+    PopupBlockHandle *popup = nullptr;
+    for (wmEventHandler &handler_base : *handlers) {
+      if (handler_base.type != WM_HANDLER_TYPE_UI) {
+        continue;
+      }
+      wmEventHandler_UI *handler = reinterpret_cast<wmEventHandler_UI *>(&handler_base);
+      if (handler->handle_fn == ui_popup_handler && handler->remove_fn == ui_popup_handler_remove) {
+        PopupBlockHandle *candidate = static_cast<PopupBlockHandle *>(handler->user_data);
+        if (WM_xr_hand_menu_region_owned(wm, candidate->region)) {
+          popup = candidate;
+          break;
+        }
+      }
+    }
+    if (!popup) {
+      break;
+    }
+    /* Unlink before native cancellation callbacks run, then search again: closing a
+     * parent may free nested menus and mutate the handler list. */
+    popup_handlers_remove(handlers, popup);
+    ui_popup_handler_remove(C, popup);
+    if (CTX_wm_window(C) != win) {
+      break;
+    }
+  }
+#else
+  UNUSED_VARS(C, handlers);
+#endif
+}
