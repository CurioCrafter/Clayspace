+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+
+namespace blender::xr_camera {
+constexpr uint32_t eye_size = 960;
+constexpr size_t eye_bytes = size_t(eye_size) * eye_size * 4;
+constexpr size_t stereo_bytes = eye_bytes * 2;
+constexpr size_t packet_header_bytes = 80;
+constexpr size_t packet_record_bytes = 184;
+constexpr uint64_t max_capture_age_ns = 500000000u;
+
+inline bool fresh_capture(uint64_t captured_ns, uint64_t now_ns)
+{
+  return now_ns >= captured_ns && now_ns - captured_ns <= max_capture_age_ns;
+}
+
+inline uint32_t read_u32_le(const unsigned char *bytes)
+{
+  return uint32_t(bytes[0]) | (uint32_t(bytes[1]) << 8) |
+         (uint32_t(bytes[2]) << 16) | (uint32_t(bytes[3]) << 24);
+}
+
+inline uint64_t read_u64_le(const unsigned char *bytes)
+{
+  return uint64_t(read_u32_le(bytes)) | (uint64_t(read_u32_le(bytes + 4)) << 32);
+}
+
+inline float read_f32_le(const unsigned char *bytes)
+{
+  const uint32_t bits = read_u32_le(bytes);
+  float value;
+  std::memcpy(&value, &bits, sizeof(value));
+  return value;
+}
+
+inline bool valid_header(const std::array<uint32_t, 6> &header)
+{
+  return header[0] == 0x42575258u && header[1] == 1u && header[2] == eye_size &&
+         header[3] == eye_size && header[4] <= 4 && header[5] <= 4;
+}
+
+inline bool valid_packet_header(const std::array<unsigned char, packet_header_bytes> &header)
+{
+  const auto word = [&](size_t index) { return read_u32_le(header.data() + index * 4); };
+  const uint64_t captured = read_u64_le(header.data() + 64);
+  const uint64_t published = read_u64_le(header.data() + 72);
+  return word(0) == 0x4D575258u && word(1) == 2u && word(2) == packet_header_bytes &&
+         word(3) == eye_size && word(4) == eye_size && word(6) == 7u &&
+         word(7) == eye_bytes && word(8) <= 4u && word(9) <= 4u && word(10) <= 4u &&
+         word(15) == 0u && published >= captured &&
+         word(14) == uint32_t(std::min<uint64_t>((published - captured) / 1000000u,
+                                                std::numeric_limits<uint32_t>::max()));
+}
+}  // namespace blender::xr_camera
