+void WM_xr_task_card_info(const wmXrData *xr, int r_values[6])
+{
+  std::fill_n(r_values, 6, 0);
+  r_values[3] = -1;
+  if (xr && xr->runtime) {
+    const xr_task::State &card = xr->runtime->task_card;
+    r_values[0] = card.visible;
+    r_values[1] = card.generation;
+    r_values[2] = card.drawn_generation;
+    r_values[3] = card.captured_action ? card.captured_pointer : -1;
+    r_values[4] = card.captured_action;
+    r_values[5] = card.opacity_percent;
+  }
+}
