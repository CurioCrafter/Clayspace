+
+void GHOST_XrSession::destroyHandTrackers()
+{
+  for (XrHandTrackerEXT &tracker : oxr_->hand_trackers) {
+    if (tracker != XR_NULL_HANDLE && oxr_->destroy_hand_tracker) {
+      if (XR_FAILED(oxr_->destroy_hand_tracker(tracker))) {
+        fprintf(stderr, "XR_WORKBENCH hand_tracker_destroy=failed\n");
+      }
+    }
+    tracker = XR_NULL_HANDLE;
+  }
+  invalidateHandSamples();
+}
+
+bool GHOST_XrSession::setHandTrackingEnabled(bool enabled)
+{
+  if (!enabled) {
+    destroyHandTrackers();
+    printf("XR_WORKBENCH hand_tracking_status=disabled\n");
+    fflush(stdout);
+    return true;
+  }
+  if (!oxr_->hand_tracking_supported || oxr_->session == XR_NULL_HANDLE) {
+    return false;
+  }
+  if (oxr_->hand_trackers[0] && oxr_->hand_trackers[1]) {
+    return true;
+  }
+  destroyHandTrackers();
+  if (XR_FAILED(xrGetInstanceProcAddr(context_->getInstance(), "xrCreateHandTrackerEXT",
+                reinterpret_cast<PFN_xrVoidFunction *>(&oxr_->create_hand_tracker))) ||
+      XR_FAILED(xrGetInstanceProcAddr(context_->getInstance(), "xrDestroyHandTrackerEXT",
+                reinterpret_cast<PFN_xrVoidFunction *>(&oxr_->destroy_hand_tracker))) ||
+      XR_FAILED(xrGetInstanceProcAddr(context_->getInstance(), "xrLocateHandJointsEXT",
+                reinterpret_cast<PFN_xrVoidFunction *>(&oxr_->locate_hand_joints))) ||
+      !oxr_->create_hand_tracker || !oxr_->destroy_hand_tracker || !oxr_->locate_hand_joints) {
+    return false;
+  }
+  XrHandTrackingDataSourceEXT requested_source = XR_HAND_TRACKING_DATA_SOURCE_UNOBSTRUCTED_EXT;
+  XrHandTrackingDataSourceInfoEXT source_info{XR_TYPE_HAND_TRACKING_DATA_SOURCE_INFO_EXT};
+  source_info.requestedDataSourceCount = 1;
+  source_info.requestedDataSources = &requested_source;
+  for (int hand = 0; hand < 2; hand++) {
+    XrHandTrackerCreateInfoEXT info{XR_TYPE_HAND_TRACKER_CREATE_INFO_EXT};
+    info.hand = hand == 0 ? XR_HAND_LEFT_EXT : XR_HAND_RIGHT_EXT;
+    info.handJointSet = XR_HAND_JOINT_SET_DEFAULT_EXT;
+    info.next = oxr_->hand_data_source_supported ? &source_info : nullptr;
+    if (XR_FAILED(oxr_->create_hand_tracker(oxr_->session, &info, &oxr_->hand_trackers[hand])) ||
+        oxr_->hand_trackers[hand] == XR_NULL_HANDLE) {
+      destroyHandTrackers();
+      return false;
+    }
+  }
+  printf("XR_WORKBENCH hand_tracking_status=%s\n",
+         oxr_->hand_data_source_supported ? "awaiting_unobstructed_sample" : "provenance_unknown");
+  fflush(stdout);
+  return true;
+}
 
