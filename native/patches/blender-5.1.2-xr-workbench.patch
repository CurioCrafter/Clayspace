+  static const float rotation[4] = {1.0f, 0.0f, 0.0f, 0.0f};
+  ot->name = "Queue XR Test Action";
+  ot->idname = "WM_OT_xr_test_action";
+  ot->description = "Internal opt-in diagnostic of registered Workbench XR action dispatch";
+  ot->flag = OPTYPE_INTERNAL;
+  ot->poll = wm_xr_test_action_poll;
