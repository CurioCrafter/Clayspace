+namespace blender {
+
+static bool editor_window_exists(wmWindowManager *wm, const wmWindow *win)
+{
+  return win && BLI_findindex(&wm->windows, win) >= 0;
+}
+
+bool WM_xr_hand_menu_region_owned(const wmWindowManager *wm, const ARegion *region)
+{
+  return wm && wm->xr.runtime && region && wm->xr.runtime->hand_menu.regions.contains(
+      const_cast<ARegion *>(region));
+}
+
+void WM_xr_hand_menu_region_add(bContext *C, ARegion *region)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm || !wm->xr.runtime) {
+    return;
+  }
+  wmXrHandMenu &menu = wm->xr.runtime->hand_menu;
+  /* A freed address may be reused during a screen change. Never inherit its identity. */
+  if (menu.regions.contains(region)) {
+    menu.regions.remove_first_occurrence_and_reorder(region);
+  }
+  if (menu.surface.active_window == CTX_wm_window(C) && !menu.closing && !menu.freeing &&
+      (menu.opening || wm_event_is_xr_hand_menu() ||
+       WM_xr_hand_menu_region_owned(wm, CTX_wm_region(C)) ||
+       WM_xr_hand_menu_region_owned(wm, CTX_wm_region_popup(C))))
+  {
+    if (menu.regions.is_empty()) {
+      /* Native button callbacks can replace a closed popup in the same event dispatch. */
+      menu.anchor_ready = false;
+      menu.surface.drawn_frames = 0;
+      menu.surface.pointer_visible = false;
+      menu.surface.captured_button = 0;
+    }
+    menu.regions.append(region);
+    menu.surface.visible = true;
+  }
+}
+
+void WM_xr_hand_menu_region_remove(bContext *C, ARegion *region)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (wm && wm->xr.runtime) {
+    wmXrHandMenu &menu = wm->xr.runtime->hand_menu;
+    if (menu.regions.contains(region)) {
+      menu.regions.remove_first_occurrence_and_reorder(region);
+    }
+    if (menu.regions.is_empty() && !menu.opening) {
+      menu.surface.visible = false;
+      menu.surface.captured_button = 0;
+      menu.surface.pointer_visible = false;
+      if (!menu.freeing) {
+        menu.closing = false;
+      }
+    }
+  }
+}
+
+bool WM_xr_hand_menu_event_allowed(const wmWindowManager *wm,
+                                  const ARegion *region, const wmEvent *event)
+{
+  /* Lifecycle events must still close menus and advance their native tooltip timers. */
+  if (ISTIMER(event->type) || ELEM(event->type, WINDEACTIVATE, EVT_BUT_CANCEL)) {
+    return true;
+  }
+  const bool owned = WM_xr_hand_menu_region_owned(wm, region);
+  const bool menu_event = (event->flag & WM_EVENT_XR_MENU) != 0;
+  return owned == menu_event;
+}
+
+static wmXrEditorPanel editor_full_panel(const wmXrEditorSurface &surface)
+{
+  return {0, 0, surface.pixel_width, surface.pixel_height, 0.0f, 0.0f,
+          surface.width, surface.height, nullptr};
+}
+
+static wmXrEditorPanel editor_panel_get(const wmXrEditorSurface &surface, int index)
+{
+  return surface.panel_count ? surface.panels[index] : editor_full_panel(surface);
+}
+
+static bool editor_panel_equal(const wmXrEditorPanel &a, const wmXrEditorPanel &b)
+{
+  return a.area == b.area && a.xmin == b.xmin && a.ymin == b.ymin && a.xmax == b.xmax &&
+         a.ymax == b.ymax && a.x == b.x && a.y == b.y && a.width == b.width &&
+         a.height == b.height;
+}
+
+static bool editor_panel_from_area(const wmXrEditorSurface &surface,
+                                   const ScrArea &area,
+                                   wmXrEditorPanel &panel)
+{
+  panel = {};
+  panel.xmin = std::clamp(area.totrct.xmin, 0, surface.pixel_width);
+  panel.ymin = std::clamp(area.totrct.ymin, 0, surface.pixel_height);
+  panel.xmax = std::clamp(area.totrct.xmax + 1, 0, surface.pixel_width);
+  panel.ymax = std::clamp(area.totrct.ymax + 1, 0, surface.pixel_height);
+  panel.area = &area;
+  return panel.xmax - panel.xmin >= 64 && panel.ymax - panel.ymin >= 64;
+}
+
+static void editor_panels_prepare(wmXrEditorSurface &surface, const bScreen *screen,
+                                  const wmWindowManager *wm)
+{
+  wmXrEditorPanel panels[3] = {editor_full_panel(surface)};
+  int count = 1;
+  /* Popovers may extend outside their owning area. Child preferences/file-browser windows
+   * and every transient popup retain the complete native window and its event coordinates. */
+  bool desktop_popup = false;
+  if (screen) {
+    for (const ARegion &region : screen->regionbase) {
+      desktop_popup |= !WM_xr_hand_menu_region_owned(wm, &region);
+    }
+  }
+  if (surface.separated && surface.active_window == surface.source_window && screen &&
+      !desktop_popup)
+  {
+    count = 0;
+    for (int slot = 0; slot < 3; slot++) {
+      const ScrArea *best = nullptr;
+      int64_t best_score = -1;
+      wmXrEditorPanel candidate, chosen;
+      for (const ScrArea &area : screen->areabase) {
+        bool used = false;
+        for (int i = 0; i < count; i++) {
+          used |= panels[i].area == &area;
+        }
+        if (used || !editor_panel_from_area(surface, area, candidate)) {
+          continue;
+        }
+        int64_t score = int64_t(candidate.xmax - candidate.xmin) *
+                        (candidate.ymax - candidate.ymin);
+        if ((slot == 0 && area.spacetype == SPACE_VIEW3D) ||
+            (slot == 1 && area.spacetype == SPACE_PROPERTIES) ||
+            (slot == 2 && area.spacetype == SPACE_OUTLINER))
+        {
+          score += int64_t(surface.pixel_width) * surface.pixel_height;
+        }
+        if (score > best_score) {
+          best = &area;
+          best_score = score;
+          chosen = candidate;
+        }
+      }
+      if (!best) {
+        break;
+      }
+      chosen.width = surface.width * (slot == 0 ? 1.0f : 0.48f);
+      chosen.height = chosen.width * float(chosen.ymax - chosen.ymin) /
+                      float(chosen.xmax - chosen.xmin);
+      if (slot > 0) {
+        const float max_height = panels[0].height * 1.35f;
+        if (chosen.height > max_height) {
+          chosen.width *= max_height / chosen.height;
+          chosen.height = max_height;
+        }
+        const float offset = (panels[0].width + chosen.width) * 0.5f + surface.width * 0.06f;
+        chosen.x = slot == 1 ? offset : -offset;
+      }
+      panels[count++] = chosen;
+    }
+    if (!count) {
+      panels[0] = editor_full_panel(surface);
+      count = 1;
+    }
+  }
+  bool changed = count != surface.panel_count;
+  for (int i = 0; i < count; i++) {
+    changed |= !editor_panel_equal(panels[i], surface.panels[i]);
+    surface.panels[i] = panels[i];
+  }
+  surface.panel_count = count;
+  if (changed) {
+    surface.pointer_visible = false;
+    surface.pointer_panel = 0;
+  }
+}
+
+static bool editor_capture_layout_valid(const wmXrEditorSurface &surface,
+                                        const bScreen *screen,
+                                        int width, int height)
+{
+  if (width != surface.pixel_width || height != surface.pixel_height) {
+    return false;
+  }
+  for (int i = 0; i < surface.panel_count; i++) {
+    const wmXrEditorPanel &panel = surface.panels[i];
+    if (!panel.area) {
+      continue;
+    }
+    wmXrEditorPanel current;
+    if (!screen || BLI_findindex(&screen->areabase, panel.area) < 0 ||
+        !editor_panel_from_area(surface, *panel.area, current) ||
+        current.xmin != panel.xmin || current.ymin != panel.ymin ||
+        current.xmax != panel.xmax || current.ymax != panel.ymax)
+    {
+      return false;
+    }
+  }
+  return true;
+}
+
+/* Rendering and ray input share exactly these crop rectangles. A captured pointer stays
+ * with its original panel even when its ray crosses a gap or another panel. */
+static bool editor_panel_hit(const wmXrEditorSurface &surface,
+                             float x, float y, float &u, float &v, int &index)
+{
+  const int count = std::max(surface.panel_count, 1);
+  for (int i = 0; i < count; i++) {
+    if (surface.captured_button && i != surface.pointer_panel) {
+      continue;
+    }
+    const wmXrEditorPanel panel = editor_panel_get(surface, i);
+    const float local_u = (x - panel.x) / panel.width + 0.5f;
+    const float local_v = (y - panel.y) / panel.height + 0.5f;
+    const bool inside = local_u >= 0.0f && local_u <= 1.0f &&
+                        local_v >= 0.0f && local_v <= 1.0f;
+    if (inside || surface.captured_button) {
+      u = (panel.xmin + std::clamp(local_u, 0.0f, 1.0f) * (panel.xmax - panel.xmin - 1)) /
+          float(std::max(surface.pixel_width - 1, 1));
+      v = (panel.ymin + std::clamp(local_v, 0.0f, 1.0f) * (panel.ymax - panel.ymin - 1)) /
+          float(std::max(surface.pixel_height - 1, 1));
+      index = i;
+      return inside;
+    }
+  }
+  return false;
+}
+
+void WM_xr_editor_surface_info_get(const wmXrData *xr, int r_values[6])
+{
+  std::fill_n(r_values, 6, 0);
+  r_values[3] = -1;
+  if (xr && xr->runtime) {
+    const wmXrEditorSurface &surface = xr->runtime->editor_surface;
+    r_values[0] = surface.visible;
+    r_values[1] = surface.pixel_width;
+    r_values[2] = surface.pixel_height;
+    r_values[3] = surface.captured_button ? surface.pointer_id : -1;
+    r_values[4] = surface.captured_button;
+    r_values[5] = surface.drawn_frames;
+  }
+}
+
+void WM_xr_editor_surface_pose_get(const wmXrData *xr, float r_values[9])
+{
+  std::fill_n(r_values, 9, 0.0f);
+  if (xr && xr->runtime && xr->runtime->editor_surface.visible) {
+    const wmXrEditorSurface &surface = xr->runtime->editor_surface;
+    copy_v3_v3(r_values, surface.pose.position);
+    copy_qt_qt(r_values + 3, surface.pose.orientation_quat);
+    r_values[7] = surface.width;
+    r_values[8] = surface.height;
+  }
+}
+
+void WM_xr_editor_surface_hit_get(const wmXrData *xr,
+                                 const float ray_origin[3],
+                                 const float ray_direction[3],
+                                 float r_values[5])
+{
+  std::fill_n(r_values, 5, 0.0f);
+  r_values[1] = -1.0f;
+  if (!BLI_thread_is_main() || !xr || !xr->runtime || !wm_xr_ui_input_ready(xr->runtime)) {
+    return;
+  }
+  const wmXrEditorSurface &surface = xr->runtime->editor_surface;
+  if (!surface.visible || surface.captured_button || xr->runtime->task_card.captured_action ||
+      surface.pixel_width < 1 || surface.pixel_height < 1)
+  {
+    return;
+  }
+  double length_squared = 0.0;
+  for (int i = 0; i < 3; i++) {
+    if (!std::isfinite(ray_origin[i]) || !std::isfinite(ray_direction[i])) {
+      return;
+    }
+    length_squared += double(ray_direction[i]) * ray_direction[i];
+  }
+  if (length_squared <= 1.0e-20) {
+    return;
+  }
+  const double length = std::sqrt(length_squared);
+  float origin[3], direction[3], inverse[4][4];
+  copy_v3_v3(origin, ray_origin);
+  for (int i = 0; i < 3; i++) {
+    direction[i] = float(ray_direction[i] / length);
+  }
+  wm_xr_pose_to_imat(&surface.pose, inverse);
+  mul_m4_v3(inverse, origin);
+  mul_mat3_m4_v3(inverse, direction);
+  if (origin[2] <= 0.0f || direction[2] >= -1.0e-7f) {
+    return;
+  }
+  const float distance = -origin[2] / direction[2];
+  float u = 0.0f, v = 0.0f;
+  int panel = -1;
+  if (!std::isfinite(distance) ||
+      !editor_panel_hit(surface, origin[0] + direction[0] * distance,
+                        origin[1] + direction[1] * distance, u, v, panel))
+  {
+    return;
+  }
+  r_values[0] = 1.0f;
+  r_values[1] = float(panel);
+  r_values[2] = u;
+  r_values[3] = v;
+  r_values[4] = distance;
+}
+
+bool WM_xr_editor_surface_event_filter(wmWindowManager *wm, wmWindow *win, const wmEvent *event)
+{
+  if (event->flag & WM_EVENT_XR_MENU) {
+    return !wm->xr.runtime ||
+           wm->xr.runtime->hand_menu.surface.active_window != win ||
+           wm->xr.runtime->hand_menu.regions.is_empty() ||
+           (wm->xr.runtime->hand_menu.closing && event->type != EVT_ESCKEY);
+  }
+  if (!wm->xr.runtime || (event->flag & WM_EVENT_XR_EDITOR)) {
+    return false;
+  }
+  const wmXrEditorSurface &surface = wm->xr.runtime->editor_surface;
+  if (!surface.visible || surface.active_window != win) {
+    return false;
+  }
+  if (event->type == EVT_ESCKEY && event->val == KM_PRESS) {
+    wm_xr_editor_surface_cancel(wm);
+  }
+  return surface.captured_button && ISMOUSE(event->type);
+}
+
+static void editor_queue(wmWindow *win, wmXrEditorSurface &surface, wmEvent &event)
+{
+  if (surface.hand_menu) {
+    event.flag |= WM_EVENT_XR_MENU;
+  }
+  event.custom = 0;
+  event.customdata = nullptr;
+  event.customdata_free = false;
+  WM_event_tablet_data_default_set(&event.tablet);
+  event.tablet.is_motion_absolute = true;
+  wm_event_add_xr_editor(win, &event, &surface.event_state, &surface.previous_press_time);
+}
+
+void wm_xr_editor_surface_cancel(wmWindowManager *wm)
+{
+  if (!wm || !wm->xr.runtime) {
+    return;
+  }
+  wmXrEditorSurface &surface = wm->xr.runtime->editor_surface;
+  if (surface.visible && editor_window_exists(wm, surface.active_window)) {
+    wmEvent event = surface.event_state;
+    event.utf8_buf[0] = '\0';
+    event.type = EVT_ESCKEY;
+    event.val = KM_PRESS;
+    editor_queue(surface.active_window, surface, event);
+    if (surface.captured_button) {
+      event.type = wmEventType(surface.captured_button);
+      event.val = KM_RELEASE;
+      editor_queue(surface.active_window, surface, event);
+    }
+  }
+  surface.visible = false;
+  surface.pointer_visible = false;
+  surface.captured_button = 0;
+  surface.panel_count = 0;
+  surface.capture_path[0] = '\0';
+}
+
+static void editor_capture_write(wmXrEditorSurface &surface, GPUOffScreen *offscreen)
+{
+  if (surface.capture_path[0] && !wm_xr_camera_overlay_requested()) {
+    ImBuf *image = IMB_allocImBuf(GPU_offscreen_width(offscreen),
+                                  GPU_offscreen_height(offscreen), 32, IB_byte_data);
+    bool saved = false;
+    if (image) {
+      GPU_offscreen_read_color(offscreen, GPU_DATA_UBYTE, image->byte_buffer.data);
+      image->ftype = IMB_FTYPE_PNG;
+      saved = IMB_save_image(image, surface.capture_path, IB_byte_data);
+      IMB_freeImBuf(image);
+    }
+    printf("XR_%s_CAPTURE saved=%d frame=%d room_capture=0\n",
+           surface.hand_menu ? "HAND_MENU" : "EDITOR", int(saved), surface.drawn_frames);
+    fflush(stdout);
+  }
+  surface.capture_path[0] = '\0';
+}
+
+void wm_xr_editor_surface_prepare(bContext *C, wmXrSurfaceData *data)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  wmXrEditorSurface &surface = wm->xr.runtime->editor_surface;
+  if (!surface.visible) {
+    return;
+  }
+  if (!wm_xr_ui_input_ready(wm->xr.runtime)) {
+    wm_xr_editor_surface_cancel(wm);
+    return;
+  }
+  if (!editor_window_exists(wm, surface.source_window) ||
+      (surface.captured_button && !editor_window_exists(wm, surface.active_window)))
+  {
+    wm_xr_editor_surface_cancel(wm);
+    return;
+  }
+  wmWindow *win = surface.source_window;
+  /* Blender file browsers/preferences can be child windows, never another process.
+   * Do not change targets while a pointer button is captured. */
+  if (!surface.captured_button) {
+    for (wmWindow &child : wm->windows) {
+      if (child.parent == surface.source_window) {
+        win = &child;
+      }
+    }
+  }
+  else if (editor_window_exists(wm, surface.active_window)) {
+    win = surface.active_window;
+  }
+  const int2 size = WM_window_native_pixel_size(win);
+  if (size.x < 1 || size.y < 1) {
+    return;
+  }
+  const bScreen *screen = WM_window_get_active_screen(win);
+  if (surface.captured_button && !editor_capture_layout_valid(surface, screen, size.x, size.y)) {
+    /* A workspace switch/resize must not reinterpret an in-progress press. */
+    wm_xr_editor_surface_cancel(wm);
+    return;
+  }
+  if (surface.active_window != win) {
+    surface.pointer_visible = false;
+    surface.previous_press_time = 0;
+  }
+  surface.active_window = win;
+  surface.pixel_width = size.x;
+  surface.pixel_height = size.y;
+  surface.height = surface.width * float(size.y) / float(size.x);
+  if (!surface.captured_button) {
+    editor_panels_prepare(surface, screen, wm);
+  }
+  if (data->editor_offscreen && (GPU_offscreen_width(data->editor_offscreen) != size.x ||
+                                 GPU_offscreen_height(data->editor_offscreen) != size.y))
+  {
+    GPU_offscreen_free(data->editor_offscreen);
+    data->editor_offscreen = nullptr;
+  }
+  if (!data->editor_offscreen) {
+    data->editor_offscreen = GPU_offscreen_create(size.x,
+                                                  size.y,
+                                                  false,
+                                                  gpu::TextureFormat::UNORM_8_8_8_8,
+                                                  GPU_TEXTURE_USAGE_SHADER_READ,
+                                                  false,
+                                                  nullptr);
+    if (!data->editor_offscreen) {
+      wm_xr_editor_surface_cancel(wm);
+      return;
+    }
+  }
+  wm_draw_window_to_offscreen(C, win, data->editor_offscreen);
+  if (surface.drawn_frames < INT_MAX) {
+    surface.drawn_frames++;
+  }
+  editor_capture_write(surface, data->editor_offscreen);
+}
+
+static void editor_surface_draw(const wmXrDrawData *data,
+                                const wmXrEditorSurface &surface,
+                                GPUOffScreen *offscreen,
+                                const float viewmat[4][4],
+                                const float winmat[4][4])
+{
+  if (!surface.visible || !offscreen || surface.pixel_width < 1 || surface.pixel_height < 1) {
+    return;
+  }
+  float model[4][4];
+  const GPUBlend old_blend = GPU_blend_get();
+  const GPUDepthTest old_depth = GPU_depth_test_get();
+  wm_xr_pose_to_mat(&surface.pose, model);
+  GPU_matrix_push();
+  GPU_matrix_push_projection();
+  GPU_matrix_set(viewmat);
+  GPU_matrix_mul(model);
+  float projection[4][4];
+  copy_m4_m4(projection, winmat);
+  if (GHOST_XrSessionNeedsUpsideDownDrawing(data->xr_data->runtime->ghost_context)) {
+    for (int column = 0; column < 4; column++) {
+      projection[column][1] = -projection[column][1];
+    }
+  }
+  GPU_matrix_projection_set(projection);
+  GPU_depth_test(GPU_DEPTH_NONE);
+  GPU_blend(surface.hand_menu ? GPU_BLEND_ALPHA_PREMULT : GPU_BLEND_NONE);
+  gpu::Texture *texture = GPU_offscreen_color_texture(offscreen);
+  GPUVertFormat *format = immVertexFormat();
+  const uint pos = GPU_vertformat_attr_add(format, "pos", gpu::VertAttrType::SFLOAT_32_32_32);
+  const uint uv = GPU_vertformat_attr_add(format, "texCoord", gpu::VertAttrType::SFLOAT_32_32);
+  GPU_texture_bind(texture, 0);
+  immBindBuiltinProgram(GPU_SHADER_3D_IMAGE);
+  immUniform1i("image", 0);
+  for (int i = 0; i < std::max(surface.panel_count, 1); i++) {
+    const wmXrEditorPanel panel = editor_panel_get(surface, i);
+    const float w = panel.width * 0.5f, h = panel.height * 0.5f;
+    const float u0 = float(panel.xmin) / surface.pixel_width;
+    const float v0 = float(panel.ymin) / surface.pixel_height;
+    const float u1 = float(panel.xmax) / surface.pixel_width;
+    const float v1 = float(panel.ymax) / surface.pixel_height;
+    immBegin(GPU_PRIM_TRI_FAN, 4);
+    immAttr2f(uv, u0, v0);
+    immVertex3f(pos, panel.x - w, panel.y - h, 0.0f);
+    immAttr2f(uv, u1, v0);
+    immVertex3f(pos, panel.x + w, panel.y - h, 0.0f);
+    immAttr2f(uv, u1, v1);
+    immVertex3f(pos, panel.x + w, panel.y + h, 0.0f);
+    immAttr2f(uv, u0, v1);
+    immVertex3f(pos, panel.x - w, panel.y + h, 0.0f);
+    immEnd();
+  }
+  immUnbindProgram();
+  GPU_texture_unbind(texture);
+  if (surface.pointer_visible && surface.pointer_panel >= 0 &&
+      surface.pointer_panel < std::max(surface.panel_count, 1))
+  {
+    const wmXrEditorPanel panel = editor_panel_get(surface, surface.pointer_panel);
+    const float x = panel.x +
+                    (float(surface.event_state.xy[0] - panel.xmin) /
+                         std::max(panel.xmax - panel.xmin - 1, 1) - 0.5f) * panel.width;
+    const float y = panel.y +
+                    (float(surface.event_state.xy[1] - panel.ymin) /
+                         std::max(panel.ymax - panel.ymin - 1, 1) - 0.5f) * panel.height;
+    const uint cursor_pos = GPU_vertformat_attr_add(
+        immVertexFormat(), "pos", gpu::VertAttrType::SFLOAT_32_32_32);
+    immBindBuiltinProgram(GPU_SHADER_3D_UNIFORM_COLOR);
+    immUniformColor4f(0.15f, 0.9f, 1.0f, 1.0f);
+    immBegin(GPU_PRIM_LINES, 4);
+    immVertex3f(cursor_pos, x - 0.007f, y, 0.001f);
+    immVertex3f(cursor_pos, x + 0.007f, y, 0.001f);
+    immVertex3f(cursor_pos, x, y - 0.007f, 0.001f);
+    immVertex3f(cursor_pos, x, y + 0.007f, 0.001f);
+    immEnd();
+    immUnbindProgram();
+  }
+  GPU_matrix_pop_projection();
+  GPU_matrix_pop();
+  GPU_blend(old_blend);
+  GPU_depth_test(old_depth);
+}
+
+static bool editor_poll(bContext *C)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  return wm && wm->xr.runtime && WM_xr_session_is_ready(&wm->xr);
+}
+
+void wm_xr_editor_surface_draw(const wmXrDrawData *data,
+                              const float viewmat[4][4], const float winmat[4][4])
+{
+  editor_surface_draw(data, data->xr_data->runtime->editor_surface,
+                      data->surface_data->editor_offscreen, viewmat, winmat);
+  editor_surface_draw(data, data->xr_data->runtime->hand_menu.surface,
+                      data->surface_data->hand_menu_offscreen, viewmat, winmat);
+}
+
+void WM_xr_hand_menu_info_get(const wmXrData *xr, int r_values[6])
+{
+  std::fill_n(r_values, 6, 0);
+  r_values[3] = -1;
+  if (xr && xr->runtime) {
+    const wmXrEditorSurface &s = xr->runtime->hand_menu.surface;
+    r_values[0] = s.visible;
+    r_values[1] = s.pixel_width;
+    r_values[2] = s.pixel_height;
+    r_values[3] = s.captured_button ? s.pointer_id : -1;
+    r_values[4] = s.captured_button;
+    r_values[5] = s.drawn_frames;
+  }
+}
+
+void WM_xr_hand_menu_pose_get(const wmXrData *xr, float r_values[9])
+{
+  std::fill_n(r_values, 9, 0.0f);
+  if (xr && xr->runtime && xr->runtime->hand_menu.surface.visible) {
+    const wmXrEditorSurface &s = xr->runtime->hand_menu.surface;
+    copy_v3_v3(r_values, s.pose.position);
+    copy_qt_qt(r_values + 3, s.pose.orientation_quat);
+    r_values[7] = s.width;
+    r_values[8] = s.height;
+  }
+}
+
+void wm_xr_hand_menu_cancel(wmWindowManager *wm)
+{
+  if (!wm || !wm->xr.runtime) {
+    return;
+  }
+  wmXrHandMenu &menu = wm->xr.runtime->hand_menu;
+  if (!menu.closing && !menu.regions.is_empty() &&
+      editor_window_exists(wm, menu.surface.active_window))
+  {
+    wmEvent event = menu.surface.event_state;
+    event.type = EVT_ESCKEY;
+    event.val = KM_PRESS;
+    event.utf8_buf[0] = '\0';
+    editor_queue(menu.surface.active_window, menu.surface, event);
+    menu.closing = true;
+  }
+  menu.surface.visible = false;
+  menu.surface.pointer_visible = false;
+  menu.surface.captured_button = 0;
+}
+
+void wm_xr_hand_menu_free(wmWindowManager *wm)
+{
+  if (!wm || !wm->xr.runtime) {
+    return;
+  }
+  wmXrHandMenu &menu = wm->xr.runtime->hand_menu;
+  if (menu.freeing) {
+    return;
+  }
+  wmXrRuntimeData *expected_runtime = wm->xr.runtime;
+  menu.freeing = true;
+  menu.surface.visible = false;
+  menu.closing = true;
+  wmWindow *win = menu.surface.active_window;
+  if (editor_window_exists(wm, win)) {
+    bContext *C = CTX_create();
+    CTX_data_main_set(C, G_MAIN);
+    CTX_wm_manager_set(C, wm);
+    CTX_wm_window_set(C, win);
+    ui::popup_handlers_remove_xr(C, &win->runtime->modalhandlers);
+    CTX_free(C);
+  }
+  /* Add-on cancellation callbacks may replace the window manager/session. */
+  if (BLI_findindex(&G_MAIN->wm, wm) < 0 || wm->xr.runtime != expected_runtime) {
+    return;
+  }
+  menu.regions.clear();
+  menu.closing = false;
+  menu.freeing = false;
+  menu.surface.captured_button = 0;
+}
+
+static bool hand_menu_anchor(wmXrRuntimeData *runtime)
+{
+  wmXrHandMenu &menu = runtime->hand_menu;
+  GHOST_XrPose viewer;
+  float scale;
+  if (!wm_xr_ui_anchor_get(runtime, viewer, scale)) {
+    return false;
+  }
+  wmXrController *controller = static_cast<wmXrController *>(
+      BLI_findlink(&runtime->session_state.controllers, menu.controller));
+  if (menu.simulated) {
+    menu.surface.pose = viewer;
+    float offset[3] = {-0.15f * scale, -0.10f * scale, -0.65f * scale};
+    mul_qt_v3(viewer.orientation_quat, offset);
+    add_v3_v3(menu.surface.pose.position, offset);
+    return true;
+  }
+  if (!controller || !controller->grip_active) {
+    return false;
+  }
+  /* Controller-relative position, head-facing text: turning the wrist never flips the menu.
+   * This is a hand surface, not a crop of the desktop editor rig. */
+  menu.surface.pose = viewer;
+  copy_v3_v3(menu.surface.pose.position, controller->grip_pose.position);
+  float offset[3] = {0.0f, 0.17f * scale, -0.03f * scale};
+  mul_qt_v3(viewer.orientation_quat, offset);
+  add_v3_v3(menu.surface.pose.position, offset);
+  for (int i = 0; i < 3; i++) {
+    if (!std::isfinite(menu.surface.pose.position[i])) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void wm_xr_hand_menu_prepare(bContext *C, wmXrSurfaceData *data)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  wmXrHandMenu &menu = wm->xr.runtime->hand_menu;
+  wmXrEditorSurface &s = menu.surface;
+  if (menu.closing) {
+    /* Outside event dispatch: close the complete native tree, including keep-open parents.
+     * One Escape alone only dismisses a nested submenu. */
+    wm_xr_hand_menu_free(wm);
+    return;
+  }
+  if (!s.visible) {
+    return;
+  }
+  if (!editor_window_exists(wm, s.active_window) || !wm_xr_ui_input_ready(wm->xr.runtime) ||
+      !hand_menu_anchor(wm->xr.runtime))
+  {
+    wm_xr_hand_menu_cancel(wm);
+    return;
+  }
+  bScreen *screen = WM_window_get_active_screen(s.active_window);
+  for (int i = int(menu.regions.size()) - 1; i >= 0; i--) {
+    if (!screen || BLI_findindex(&screen->regionbase, menu.regions[i]) < 0) {
+      menu.regions.remove(i);
+    }
+  }
+  if (menu.regions.is_empty()) {
+    s.visible = false;
+    s.captured_button = 0;
+    return;
+  }
+  const int2 size = WM_window_native_pixel_size(s.active_window);
+  if (size.x < 1 || size.y < 1) {
+    wm_xr_hand_menu_cancel(wm);
+    return;
+  }
+  /* Resizing must not reinterpret a pressed button at a different pixel. */
+  if (s.captured_button && (s.pixel_width != size.x || s.pixel_height != size.y)) {
+    wm_xr_hand_menu_cancel(wm);
+    return;
+  }
+  const rcti &root = menu.regions.first()->winrct;
+  if (!menu.anchor_ready) {
+    const int root_width = root.xmax - root.xmin + 1;
+    if (root_width < 2) {
+      return;
+    }
+    menu.root_center[0] = (root.xmin + root.xmax + 1) * 0.5f;
+    menu.root_center[1] = (root.ymin + root.ymax + 1) * 0.5f;
+    const float scale = wm->xr.runtime->session_state.prev_base_scale *
+                        wm->xr.runtime->session_state.viewer_scale;
+    if (menu.meters_per_pixel <= 0.0f) {
+      menu.meters_per_pixel = menu.width_meters * scale / root_width;
+    }
+    menu.anchor_ready = true;
+  }
+  wmXrEditorPanel panel = {};
+  panel.xmin = size.x;
+  panel.ymin = size.y;
+  for (ARegion *region : menu.regions) {
+    if (!region->runtime->visible) {
+      continue;
+    }
+    panel.xmin = std::min(panel.xmin, std::clamp(region->winrct.xmin, 0, size.x));
+    panel.ymin = std::min(panel.ymin, std::clamp(region->winrct.ymin, 0, size.y));
+    panel.xmax = std::max(panel.xmax, std::clamp(region->winrct.xmax + 1, 0, size.x));
+    panel.ymax = std::max(panel.ymax, std::clamp(region->winrct.ymax + 1, 0, size.y));
+  }
+  if (panel.xmax <= panel.xmin || panel.ymax <= panel.ymin) {
+    return;
+  }
+  panel.width = (panel.xmax - panel.xmin) * menu.meters_per_pixel;
+  panel.height = (panel.ymax - panel.ymin) * menu.meters_per_pixel;
+  panel.x = ((panel.xmin + panel.xmax) * 0.5f - menu.root_center[0]) * menu.meters_per_pixel;
+  panel.y = ((panel.ymin + panel.ymax) * 0.5f - menu.root_center[1]) * menu.meters_per_pixel;
+  s.pixel_width = size.x;
+  s.pixel_height = size.y;
+  s.width = size.x * menu.meters_per_pixel;
+  s.height = size.y * menu.meters_per_pixel;
+  s.panels[0] = panel;
+  s.panel_count = 1;
+  if (data->hand_menu_offscreen && (GPU_offscreen_width(data->hand_menu_offscreen) != size.x ||
+                                  GPU_offscreen_height(data->hand_menu_offscreen) != size.y))
+  {
+    GPU_offscreen_free(data->hand_menu_offscreen);
+    data->hand_menu_offscreen = nullptr;
+  }
+  if (!data->hand_menu_offscreen) {
+    data->hand_menu_offscreen = GPU_offscreen_create(size.x, size.y, false,
+        gpu::TextureFormat::UNORM_8_8_8_8, GPU_TEXTURE_USAGE_SHADER_READ, false, nullptr);
+  }
+  if (!data->hand_menu_offscreen) {
+    wm_xr_hand_menu_cancel(wm);
+    return;
+  }
+  wm_draw_xr_menu_to_offscreen(C, s.active_window, data->hand_menu_offscreen);
+  if (s.drawn_frames < INT_MAX) {
+    s.drawn_frames++;
+  }
+  editor_capture_write(s, data->hand_menu_offscreen);
+}
+
+static wmOperatorStatus hand_menu_exec(bContext *C, wmOperator *op)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  wmXrRuntimeData *runtime = wm->xr.runtime;
+  wmXrHandMenu &menu = runtime->hand_menu;
+  if (!RNA_boolean_get(op->ptr, "visible")) {
+    wm_xr_hand_menu_cancel(wm);
+    return OPERATOR_FINISHED;
+  }
+  wmWindow *win = CTX_wm_window(C);
+  if (!wm_xr_ui_input_ready(runtime) || !editor_window_exists(wm, win) ||
+      !win->runtime->eventstate || !menu.regions.is_empty() ||
+      runtime->editor_surface.captured_button || runtime->task_card.captured_action)
+  {
+    return OPERATOR_CANCELLED;
+  }
+  const float width = RNA_float_get(op->ptr, "width");
+  if (!std::isfinite(width) || width < 0.22f || width > 0.9f) {
+    return OPERATOR_CANCELLED;
+  }
+  menu.controller = RNA_int_get(op->ptr, "controller");
+  menu.simulated = RNA_boolean_get(op->ptr, "allow_simulated_input");
+  const char *allow = std::getenv("XRWB_TASK_TEST_ALLOW");
+  if (menu.simulated && (!allow || strcmp(allow, "1"))) {
+    return OPERATOR_CANCELLED;
+  }
+  /* The action's hand owns this surface until it closes. Tracking loss must not
+   * move an in-flight interaction onto the other hand. */
+  if (!hand_menu_anchor(runtime)) {
+    return OPERATOR_CANCELLED;
+  }
+  const GHOST_XrPose pose = menu.surface.pose;
+  menu.surface = {};
+  menu.surface.pose = pose;
+  menu.surface.active_window = menu.surface.source_window = win;
+  menu.surface.hand_menu = true;
+  menu.surface.visible = true;
+  menu.surface.captured_button = 0;
+  menu.surface.pointer_visible = false;
+  menu.surface.drawn_frames = 0;
+  menu.surface.event_state = *win->runtime->eventstate;
+  menu.width_meters = width;
+  menu.meters_per_pixel = 0.0f;
+  menu.anchor_ready = false;
+  menu.opening = true;
+  menu.closing = false;
+  /* Native layout uses window pixels but never moves the OS cursor. A predictable central
+   * origin leaves room for cascading menus; actual hand placement is independent of it. */
+  int previous_xy[2];
+  copy_v2_v2_int(previous_xy, win->runtime->eventstate->xy);
+  const int2 size = WM_window_native_pixel_size(win);
+  win->runtime->eventstate->xy[0] = size.x / 3;
+  win->runtime->eventstate->xy[1] = size.y * 2 / 3;
+  char panel[128], menu_name[128];
+  RNA_string_get(op->ptr, "panel", panel);
+  RNA_string_get(op->ptr, "menu", menu_name);
+  const char *operator_name = menu_name[0] ? "WM_OT_call_menu" : "WM_OT_call_panel";
+  PointerRNA properties = WM_operator_properties_create(operator_name);
+  RNA_string_set(&properties, "name", menu_name[0] ? menu_name : panel);
+  if (!menu_name[0]) {
+    RNA_boolean_set(&properties, "keep_open", true);
+  }
+  const wmOperatorStatus result = WM_operator_name_call(
+      C, operator_name, wm::OpCallContext::InvokeDefault, &properties, nullptr);
+  WM_operator_properties_free(&properties);
+  copy_v2_v2_int(win->runtime->eventstate->xy, previous_xy);
+  menu.opening = false;
+  if (!(result & (OPERATOR_INTERFACE | OPERATOR_FINISHED)) || menu.regions.is_empty()) {
+    wm_xr_hand_menu_cancel(wm);
+    return OPERATOR_CANCELLED;
+  }
+  WM_event_add_notifier(C, NC_WINDOW, nullptr);
+  return OPERATOR_FINISHED;
+}
+
+static wmOperatorStatus editor_surface_exec(bContext *C, wmOperator *op)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  wmXrRuntimeData *runtime = wm->xr.runtime;
+  wmXrEditorSurface &surface = runtime->editor_surface;
+  if (!RNA_boolean_get(op->ptr, "visible")) {
+    wm_xr_editor_surface_cancel(wm);
+    return OPERATOR_FINISHED;
+  }
+  const bool was_visible = surface.visible;
+  GHOST_XrPose anchor;
+  float scale;
+  const float width = RNA_float_get(op->ptr, "width");
+  const float distance = RNA_float_get(op->ptr, "distance");
+  if (!wm_xr_ui_input_ready(runtime) || !wm_xr_ui_anchor_get(runtime, anchor, scale) ||
+      !std::isfinite(width) || !std::isfinite(distance) || width <= 0 || distance <= 0)
+  {
+    wm_xr_editor_surface_cancel(wm);
+    return OPERATOR_CANCELLED;
+  }
+  if ((was_visible && surface.captured_button) || runtime->task_card.captured_action) {
+    /* Recall/resize must not move a target underneath a captured drag. */
+    return OPERATOR_CANCELLED;
+  }
+  if (!was_visible) {
+    surface.source_window = wm_xr_session_root_window_or_fallback_get(wm, runtime);
+    if (!editor_window_exists(wm, surface.source_window) ||
+        !surface.source_window->runtime->eventstate)
+    {
+      return OPERATOR_CANCELLED;
+    }
+    surface.active_window = surface.source_window;
+    surface.event_state = *surface.source_window->runtime->eventstate;
+    surface.captured_button = 0;
+  }
+  surface.visible = true;
+  surface.separated = RNA_boolean_get(op->ptr, "separated");
+  surface.panel_count = 0;
+  surface.pointer_panel = 0;
+  surface.pointer_visible = false;
+  surface.test_eye_captured = false;
+  surface.width = width * scale;
+  if (!was_visible || RNA_boolean_get(op->ptr, "recall")) {
+    surface.pose = anchor;
+    float forward[3] = {0.0f, 0.0f, -distance * scale};
+    mul_qt_v3(surface.pose.orientation_quat, forward);
+    add_v3_v3(surface.pose.position, forward);
+  }
+  WM_event_add_notifier(C, NC_WINDOW, nullptr);
+  return OPERATOR_FINISHED;
+}
+
+static wmOperatorStatus editor_transform_exec(bContext *C, wmOperator *op)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!BLI_thread_is_main() || !wm || !wm->xr.runtime || !wm_xr_ui_input_ready(wm->xr.runtime)) {
+    return OPERATOR_CANCELLED;
+  }
+  wmXrRuntimeData *runtime = wm->xr.runtime;
+  wmXrEditorSurface &surface = runtime->editor_surface;
+  if (!surface.visible || surface.captured_button || runtime->task_card.captured_action ||
+      !editor_window_exists(wm, surface.source_window) ||
+      !editor_window_exists(wm, surface.active_window))
+  {
+    return OPERATOR_CANCELLED;
+  }
+  GHOST_XrPose pose;
+  RNA_float_get_array(op->ptr, "position", pose.position);
+  RNA_float_get_array(op->ptr, "rotation", pose.orientation_quat);
+  const float requested_width = RNA_float_get(op->ptr, "width");
+  const float width = requested_width == 0.0f ? surface.width : requested_width;
+  if (!std::isfinite(requested_width) || !std::isfinite(width) || width <= 0.0f ||
+      !std::isfinite(surface.width) || surface.width <= 0.0f)
+  {
+    return OPERATOR_CANCELLED;
+  }
+  for (int i = 0; i < 3; i++) {
+    if (!std::isfinite(pose.position[i])) {
+      return OPERATOR_CANCELLED;
+    }
+  }
+  double rotation_squared = 0.0;
+  for (int i = 0; i < 4; i++) {
+    if (!std::isfinite(pose.orientation_quat[i])) {
+      return OPERATOR_CANCELLED;
+    }
+    rotation_squared += double(pose.orientation_quat[i]) * pose.orientation_quat[i];
+  }
+  if (rotation_squared <= 1.0e-20) {
+    return OPERATOR_CANCELLED;
+  }
+  const double rotation_length = std::sqrt(rotation_squared);
+  for (int i = 0; i < 4; i++) {
+    pose.orientation_quat[i] = float(pose.orientation_quat[i] / rotation_length);
+  }
+  const float ratio = width / surface.width;
+  if (!std::isfinite(ratio) || ratio <= 0.0f || !std::isfinite(surface.height * ratio) ||
+      surface.height * ratio <= 0.0f)
+  {
+    return OPERATOR_CANCELLED;
+  }
+  for (int i = 0; i < surface.panel_count; i++) {
+    const wmXrEditorPanel &panel = surface.panels[i];
+    if (!std::isfinite(panel.x * ratio) || !std::isfinite(panel.y * ratio) ||
+        !std::isfinite(panel.width * ratio) || !std::isfinite(panel.height * ratio) ||
+        panel.width * ratio <= 0.0f || panel.height * ratio <= 0.0f)
+    {
+      return OPERATOR_CANCELLED;
+    }
+  }
+  /* This one main-thread transaction moves the rig without recalling it, changing its
+   * separated/full-window mode, or routing any synthetic click into the editors. */
+  surface.pose = pose;
+  surface.width = width;
+  surface.height *= ratio;
+  for (int i = 0; i < surface.panel_count; i++) {
+    wmXrEditorPanel &panel = surface.panels[i];
+    panel.x *= ratio;
+    panel.y *= ratio;
+    panel.width *= ratio;
+    panel.height *= ratio;
+  }
+  surface.pointer_visible = false;
+  WM_event_add_notifier(C, NC_WINDOW, nullptr);
+  return OPERATOR_FINISHED;
+}
+
+static wmOperatorStatus editor_event_exec(bContext *C, wmOperator *op)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  if (!wm_xr_ui_input_ready(wm->xr.runtime)) {
+    wm_xr_editor_surface_cancel(wm);
+    wm_xr_hand_menu_cancel(wm);
+    return OPERATOR_CANCELLED;
+  }
+  if (wm->xr.runtime->task_card.captured_action) {
+    return OPERATOR_CANCELLED;
+  }
+  const int target = RNA_enum_get(op->ptr, "target");
+  wmXrHandMenu &menu = wm->xr.runtime->hand_menu;
+  const bool to_menu = target == 2 ||
+      (target == 0 && (menu.surface.visible || menu.closing || menu.surface.captured_button));
+  wmXrEditorSurface &surface = to_menu ? menu.surface : wm->xr.runtime->editor_surface;
+  if (to_menu && (!menu.anchor_ready || surface.drawn_frames <= 0)) {
+    return OPERATOR_CANCELLED;
+  }
+  if (!to_menu && menu.surface.visible) {
+    return OPERATOR_CANCELLED;
+  }
+  if (to_menu && !menu.simulated && !hand_menu_anchor(wm->xr.runtime)) {
+    wm_xr_hand_menu_cancel(wm);
+    return OPERATOR_CANCELLED;
+  }
+  if (!surface.visible || !editor_window_exists(wm, surface.active_window) ||
+      surface.pixel_width < 1 || surface.pixel_height < 1)
+  {
+    return OPERATOR_CANCELLED;
+  }
+  const int pointer = RNA_int_get(op->ptr, "pointer_id");
+  if (surface.captured_button && surface.pointer_id != pointer) {
+    return OPERATOR_CANCELLED;
+  }
+  wmEvent event = surface.event_state;
+  event.type = wmEventType(RNA_enum_get(op->ptr, "type"));
+  event.val = RNA_enum_get(op->ptr, "value");
+  event.flag = eWM_EventFlag(0);
+  if (!(ISKEYBOARD(event.type) || ISMOUSE_BUTTON(event.type) ||
+        ELEM(event.type, MOUSEMOVE, WHEELUPMOUSE, WHEELDOWNMOUSE)))
+  {
+    return OPERATOR_CANCELLED;
+  }
+  if ((event.type == MOUSEMOVE && event.val != KM_NOTHING) ||
+      (event.type != MOUSEMOVE && !ELEM(event.val, KM_PRESS, KM_RELEASE)))
+  {
+    return OPERATOR_CANCELLED;
+  }
+  const bool keyboard = ISKEYBOARD(event.type);
+  /* Text input belongs to existing field focus and never moves the pointer. */
+  if (!keyboard && !RNA_boolean_get(op->ptr, "use_ray")) {
+    const char *test_allow = std::getenv("XRWB_TASK_TEST_ALLOW");
+    if (!test_allow || strcmp(test_allow, "1")) {
+      /* Tracking-loss release cancels the capture instead of committing a click
+       * with invented UV coordinates. Other UV injection is test-only. */
+      if (event.val == KM_RELEASE && surface.captured_button == event.type) {
+        if (to_menu) {
+          wm_xr_hand_menu_cancel(wm);
+        }
+        else {
+          wm_xr_editor_surface_cancel(wm);
+        }
+        return OPERATOR_FINISHED;
+      }
+      return OPERATOR_CANCELLED;
+    }
+  }
+  float u = keyboard ? 0.5f : RNA_float_get(op->ptr, "u");
+  float v = keyboard ? 0.5f : RNA_float_get(op->ptr, "v");
+  bool inside = u >= 0.0f && u <= 1.0f && v >= 0.0f && v <= 1.0f;
+  int panel_index = surface.pointer_panel;
+  if (!keyboard && RNA_boolean_get(op->ptr, "use_ray")) {
+    float origin[3], direction[3], inverse[4][4];
+    RNA_float_get_array(op->ptr, "ray_origin", origin);
+    RNA_float_get_array(op->ptr, "ray_direction", direction);
+    for (int axis = 0; axis < 3; axis++) {
+      if (!std::isfinite(origin[axis]) || !std::isfinite(direction[axis])) {
+        return OPERATOR_CANCELLED;
+      }
+    }
+    wm_xr_pose_to_imat(&surface.pose, inverse);
+    mul_m4_v3(inverse, origin);
+    mul_mat3_m4_v3(inverse, direction);
+    /* The visible face points toward local +Z. Back-face and parallel rays
+     * cannot start editor input, but an existing drag may still release. */
+    if (origin[2] <= 0.0f || direction[2] >= -1.0e-7f) {
+      if (!surface.captured_button) {
+        surface.pointer_visible = false;
+        return OPERATOR_CANCELLED;
+      }
+      u = float(surface.event_state.xy[0]) / std::max(surface.pixel_width - 1, 1);
+      v = float(surface.event_state.xy[1]) / std::max(surface.pixel_height - 1, 1);
+      inside = false;
+    }
+    else {
+      const float t = -origin[2] / direction[2];
+      inside = editor_panel_hit(surface,
+                                origin[0] + direction[0] * t,
+                                origin[1] + direction[1] * t,
+                                u, v, panel_index);
+    }
+  }
+  if (!std::isfinite(u) || !std::isfinite(v)) {
+    return OPERATOR_CANCELLED;
+  }
+  if (!inside && !surface.captured_button) {
+    surface.pointer_visible = false;
+    return OPERATOR_CANCELLED;
+  }
+  if (!keyboard) {
+    event.xy[0] = int(std::clamp(u, 0.0f, 1.0f) * (surface.pixel_width - 1));
+    event.xy[1] = int(std::clamp(v, 0.0f, 1.0f) * (surface.pixel_height - 1));
+  }
+  char text[8];
+  RNA_string_get(op->ptr, "unicode", text);
+  event.utf8_buf[0] = '\0';
+  if (text[0]) {
+    const int length = BLI_str_utf8_size_or_error(text);
+    if (length <= 0 || length >= sizeof(event.utf8_buf) || text[length] != '\0' ||
+        event.val != KM_PRESS || !ISKEYBOARD(event.type))
+    {
+      return OPERATOR_CANCELLED;
+    }
+    STRNCPY(event.utf8_buf, text);
+  }
+  /* Validate the complete event before changing capture ownership. */
+  if (ISMOUSE_BUTTON(event.type)) {
+    if (event.val == KM_PRESS) {
+      if (surface.captured_button) {
+        return OPERATOR_CANCELLED;
+      }
+      surface.pointer_id = pointer;
+      surface.captured_button = event.type;
+    }
+    else {
+      if (surface.captured_button != event.type) {
+        return OPERATOR_CANCELLED;
+      }
+      surface.captured_button = 0;
+    }
+  }
+  event.modifier = wmEventModifierFlag(0);
+  if (RNA_boolean_get(op->ptr, "shift")) {
+    event.modifier |= KM_SHIFT;
+  }
+  if (RNA_boolean_get(op->ptr, "ctrl")) {
+    event.modifier |= KM_CTRL;
+  }
+  if (RNA_boolean_get(op->ptr, "alt")) {
+    event.modifier |= KM_ALT;
+  }
+  editor_queue(surface.active_window, surface, event);
+  if (!keyboard) {
+    surface.pointer_visible = inside;
+    surface.pointer_panel = panel_index;
