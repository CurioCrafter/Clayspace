+bool wm_xr_ui_input_ready(const wmXrRuntimeData *runtime)
+{
+  return GHOST_XrSessionIsFocused(runtime->ghost_context) &&
+         GHOST_XrSessionViewsValid(runtime->ghost_context);
+}
+
+bool wm_xr_ui_anchor_get(const wmXrRuntimeData *runtime, GHOST_XrPose &pose, float &scale)
+{
+  scale = runtime->session_state.prev_base_scale * runtime->session_state.viewer_scale;
+  if (!runtime->task_view_ready || !std::isfinite(scale) || scale <= 0) {
+    return false;
+  }
+  pose = runtime->task_view_pose;
+  return true;
+}
+
+void wm_xr_task_view_update(wmXrRuntimeData *runtime, const float viewmat[4][4], int view_index)
+{
+  if (view_index == 0) {
+    runtime->task_view_ready = false;
+    runtime->task_first_eye_ready = false;
+  }
+  if (view_index < 0 || view_index > 1) {
+    return;
+  }
+  float world[4][4];
+  if (!invert_m4_m4(world, viewmat)) {
+    return;
+  }
+  for (int column = 0; column < 4; column++) {
+    for (int row = 0; row < 4; row++) {
+      if (!std::isfinite(world[column][row])) {
+        return;
+      }
+    }
+  }
+  GHOST_XrPose &eye = runtime->task_eye_pose[view_index];
+  mat4_to_loc_quat(eye.position, eye.orientation_quat, world);
+  if (view_index == 0) {
+    runtime->task_first_eye_ready = true;
+  }
+  if (view_index == 1 && runtime->task_first_eye_ready) {
+    /* Placement uses the same stereo views as rendering. Some runtime states
+     * report a contradictory VIEW-space roll; never bake that into the card. */
+    mid_v3_v3v3(runtime->task_view_pose.position,
+                runtime->task_eye_pose[0].position, runtime->task_eye_pose[1].position);
+    interp_qt_qtqt(runtime->task_view_pose.orientation_quat,
+                   runtime->task_eye_pose[0].orientation_quat,
+                   runtime->task_eye_pose[1].orientation_quat, .5f);
+    runtime->task_view_ready = true;
+  }
+}
+
+void WM_xr_task_card_pose(const wmXrData *xr, float r_values[8])
+{
+  std::fill_n(r_values, 8, 0.0f);
+  if (xr && xr->runtime && xr->runtime->task_card.visible) {
+    copy_v3_v3(r_values, xr->runtime->task_card_pose.position);
+    copy_qt_qt(r_values + 3, xr->runtime->task_card_pose.orientation_quat);
+    r_values[7] = xr->runtime->task_card_width;
+  }
+}
+
+void wm_xr_task_card_free(wmXrRuntimeData *runtime)
+{
+  if (runtime->task_card_font_plus_one) {
+    BLF_unload_id(runtime->task_card_font_plus_one - 1);
+    runtime->task_card_font_plus_one = 0;
+  }
+}
+
+void wm_xr_task_card_test_capture(wmXrRuntimeData *runtime, GPUOffScreen *offscreen,
+                                 const XrSessionSettings *settings, int view_index)
+{
+  /* This debug-only file writer must never run while local room imagery is requested. */
+  if (wm_xr_camera_overlay_requested()) {
+    return;
+  }
+  const char *allow = std::getenv("XRWB_TASK_TEST_ALLOW");
+  const char *disabled = std::getenv("DISABLE_XR_APILAYER_NOVENDOR_steamvr_passthrough");
+  const char *editor_path = std::getenv("XRWB_EDITOR_EYE_CAPTURE_PATH");
+  const bool editor_capture = editor_path && runtime->editor_surface.visible &&
+                              !runtime->editor_surface.test_eye_captured;
+  const char *cursor_path = std::getenv("XRWB_TASK_CURSOR_CAPTURE_PATH");
+  static int captured_generation = 0;
+  static int captured_cursor_generation = 0;
+  const xr_task::State &card = runtime->task_card;
+  const bool cursor_capture = cursor_path && card.image_cursor_visible &&
+                              captured_cursor_generation != card.generation;
+  const char *path = cursor_capture ? cursor_path :
+                     editor_capture ? editor_path : std::getenv("XRWB_TASK_CAPTURE_PATH");
+  if (view_index != 0 || (!cursor_capture && !editor_capture &&
+      (!card.visible || card.drawn_generation != card.generation ||
+       captured_generation == card.generation)) || !allow || strcmp(allow, "1") ||
+      !disabled || strcmp(disabled, "1") || !path || !BLI_path_is_abs_from_cwd(path) ||
+      !BLI_path_extension_check(path, ".png") ||
+      (settings->draw_flags & V3D_OFSDRAW_XR_SHOW_PASSTHROUGH))
+  {
+    return;
+  }
+  if (cursor_capture) {
+    captured_cursor_generation = card.generation;
+  }
+  else if (editor_capture) {
+    runtime->editor_surface.test_eye_captured = true;
+  }
+  else {
+    captured_generation = card.generation;
+  }
+  ImBuf *image = IMB_allocImBuf(GPU_offscreen_width(offscreen),
+                               GPU_offscreen_height(offscreen), 32, IB_byte_data);
+  bool saved = false;
+  if (image) {
+    GPU_offscreen_read_color(offscreen, GPU_DATA_UBYTE, image->byte_buffer.data);
+    image->ftype = IMB_FTYPE_PNG;
+    saved = IMB_save_image(image, path, IB_byte_data);
+    IMB_freeImBuf(image);
+  }
+  printf("XR_%s_TEST_CAPTURE saved=%d generation=%d room_capture=0\n",
+         cursor_capture ? "TASK_CURSOR" : editor_capture ? "EDITOR_EYE" : "TASK",
+         int(saved), card.generation);
+  fflush(stdout);
+}
+
+void wm_xr_task_card_update(wmXrRuntimeData *runtime)
+{
+  if (!runtime->task_card_simulator && !wm_xr_ui_input_ready(runtime))
+  {
+    xr_task::cancel(runtime->task_card);
+  }
+}
