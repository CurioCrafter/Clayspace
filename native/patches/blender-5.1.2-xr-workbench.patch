@@ -0,0 +1,162 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+#pragma once
+
+#include <cmath>
+
+namespace blender::xr_task {
+
+enum class Phase { Move, Press, Release, Cancel };
+inline constexpr float default_width = 0.8f;
+inline constexpr float default_distance = 0.72f;
+/* Semantic identities, not labels or transient UI pointers. Bounds are both draw
+ * and hit bounds in the fixed 1000 by 500 presentation coordinate system. */
+struct Action {
+  int id;
+  const char *key;
+  const char *label;
+  const char *unavailable_reason;
+  float xmin, ymin, xmax, ymax;
+};
+inline constexpr Action session_actions[] = {
+    {1, "session.panel_opacity", "Panel opacity", nullptr, 60, 195, 470, 310},
+    {2, "session.exit_xr", "Exit XR", nullptr, 530, 195, 940, 310},
+    {3, "session.arrange", "Arrange Objects", nullptr, 700, 320, 940, 400},
+    {13, "session.cancel_edit", "Cancel edit", nullptr, 60, 320, 470, 400},
+    {11, "session.undo", "Undo", nullptr, 60, 65, 470, 180},
+    {12, "session.redo", "Redo", nullptr, 530, 65, 940, 180},
+};
+inline constexpr Action arrange_actions[] = {
+    {4, "arrange.session", "Session", nullptr, 700, 320, 940, 400},
+    {5, "arrange.select", "Select", nullptr, 60, 195, 340, 310},
+    {6, "arrange.move", "Move", nullptr, 360, 195, 640, 310},
+    {8, "arrange.rotate", "Rotate", nullptr, 660, 195, 940, 310},
+    {7, "arrange.scale", "Scale", nullptr, 60, 65, 340, 180},
+    {9, "arrange.add", "Add Cube", nullptr, 360, 65, 640, 180},
+    {10, "arrange.more", "More", "More tools unavailable", 660, 65, 940, 180},
+};
+
+struct State {
+  bool visible;
+  int generation;
+  int drawn_generation;
+  int captured_pointer;
+  int captured_action;
+  int hover_action;
+  unsigned neutral_mask;
+  int opacity_percent;
+  bool arrange;
+  bool tool_actions_available;
+  bool add_available;
+  bool undo_available;
+  bool redo_available;
+  bool cancel_available;
+  bool image_cursor_visible;
+  float image_cursor_x, image_cursor_y;
+};
+
+inline bool enabled(const State &state, const Action &action)
+{
+  return !action.unavailable_reason &&
+         (action.id == 13 ? state.cancel_available :
+          action.id == 11 ? state.undo_available :
+          action.id == 12 ? state.redo_available :
+          action.id == 9 ? state.add_available :
+          action.id < 5 || state.tool_actions_available);
+}
+
+inline int hit(const State &state, float x, float y)
+{
+  if (!std::isfinite(x) || !std::isfinite(y)) {
+    return 0;
+  }
+  if (state.arrange) {
+    for (const Action &action : arrange_actions) {
+      if (x >= action.xmin && x <= action.xmax && y >= action.ymin && y <= action.ymax) {
+        return enabled(state, action) ? action.id : -1;
+      }
+    }
+  }
+  else {
+    for (const Action &action : session_actions) {
+      if (x >= action.xmin && x <= action.xmax && y >= action.ymin && y <= action.ymax) {
+        return enabled(state, action) ? action.id : -1;
+      }
+    }
+  }
+  return x >= 0 && x <= 1000 && y >= 0 && y <= 500 ? -1 : 0;
+}
+
+inline void cancel(State &state)
+{
+  state.captured_pointer = -1;
+  state.captured_action = state.hover_action = 0;
+  state.neutral_mask = 0;
+  state.image_cursor_visible = false;
+}
+
+/* Returns consumed; activation is a typed intent executed on the main thread,
+ * never in either eye's drawing callback. Loss must use Cancel, not Release. */
+inline bool route(State &state, Phase phase, int pointer, int generation,
+                  int target, int &activate)
+{
+  activate = 0;
+  const bool panel_backing = target == -1;
+  target = target > 0 ? target : 0;
+  if (target) {
+    bool valid = false;
+    if (state.arrange) {
+      for (const Action &action : arrange_actions) {
+        valid |= target == action.id && enabled(state, action);
+      }
+    }
+    else {
+      for (const Action &action : session_actions) {
+        valid |= target == action.id && enabled(state, action);
+      }
+    }
+    if (!valid) {
+      target = 0;
+    }
+  }
+  if (pointer < 0 || pointer > 2 ||
+      (state.captured_action && state.captured_pointer != pointer))
+  {
+    return false;
+  }
+  if (phase == Phase::Cancel) {
+    cancel(state);
+    return true;
+  }
+  if (!state.visible || generation != state.generation ||
+      state.drawn_generation != state.generation)
+  {
+    cancel(state);
+    return false;
+  }
+  state.hover_action = target;
+  if (phase == Phase::Move) {
+    if (!state.captured_action && target) {
+      state.neutral_mask |= 1u << pointer;
+    }
+    return panel_backing || target != 0 || state.captured_action != 0;
+  }
+  if (phase == Phase::Press) {
+    const bool was_neutral = (state.neutral_mask & (1u << pointer)) != 0;
+    state.neutral_mask &= ~(1u << pointer);
+    if (!target || state.captured_action || !was_neutral) {
+      return false;
+    }
+    state.captured_pointer = pointer;
+    state.captured_action = target;
+    state.neutral_mask &= ~(1u << pointer);
+    return true;
+  }
+  if (!state.captured_action) {
+    return false;
+  }
+  activate = target == state.captured_action ? target : 0;
+  cancel(state);
+  return true;
+}
+}  // namespace blender::xr_task
