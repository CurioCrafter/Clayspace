+static bool ghost_xr_controller_pose_valid(const XrSpaceLocation &location)
+{
+  constexpr XrSpaceLocationFlags required = XR_SPACE_LOCATION_ORIENTATION_VALID_BIT |
+                                            XR_SPACE_LOCATION_POSITION_VALID_BIT |
+                                            XR_SPACE_LOCATION_ORIENTATION_TRACKED_BIT |
+                                            XR_SPACE_LOCATION_POSITION_TRACKED_BIT;
+  const XrPosef &pose = location.pose;
+  const XrQuaternionf &q = pose.orientation;
+  const float norm = q.x * q.x + q.y * q.y + q.z * q.z + q.w * q.w;
+  return (location.locationFlags & required) == required &&
+         std::isfinite(pose.position.x) && std::isfinite(pose.position.y) &&
+         std::isfinite(pose.position.z) && std::isfinite(q.x) && std::isfinite(q.y) &&
+         std::isfinite(q.z) && std::isfinite(q.w) &&
+         std::isfinite(norm) && norm > 1.0e-12f;
+}
