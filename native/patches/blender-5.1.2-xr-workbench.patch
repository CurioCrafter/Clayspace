+  mat4_to_loc_quat(pose.position, pose.orientation_quat, matrix);
+  r_values[0] = float(location.flags);
+  copy_v3_v3(r_values + 1, pose.position);
+  if (location.flags & 1) {
+    copy_qt_qt(r_values + 4, pose.orientation_quat);
+  }
+  r_values[8] = location.radius * scale;
+  for (int i = 1; i < 9; i++) {
+    if (!std::isfinite(r_values[i])) {
+      memset(r_values, 0, sizeof(float) * 9);
+      return;
+    }
+  }
+}
