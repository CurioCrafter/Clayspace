+/* -------------------------------------------------------------------- */
+/** \name Guarded Native Action Queue Diagnostic
+ * \{ */
+
+static bool wm_xr_test_env_enabled(const char *name)
+{
+  const char *value = std::getenv(name);
+  return value && STREQ(value, "1");
+}
+
+static bool wm_xr_test_action_poll(bContext *C)
+{
+  if (!BLI_thread_is_main() || !(G.f & G_FLAG_EVENT_SIMULATE) ||
+      !wm_xr_test_env_enabled("XRWB_TASK_TEST_ALLOW"))
+  {
+    return false;
+  }
+  const bool simulator = wm_xr_test_env_enabled("XRWB_HAND_MENU_SIMULATOR") &&
+                         wm_xr_test_env_enabled("XRWB_EDITOR_TEST_ALLOW") &&
+                         wm_xr_test_env_enabled("SIMULATED_ENABLE");
+  const bool smoke = wm_xr_test_env_enabled("XRWB_STEAMVR_SMOKE") &&
+                     wm_xr_test_env_enabled("XRWB_STEAMVR");
+  if ((!simulator && !smoke) ||
+      wm_xr_test_env_enabled("XRWB_INDEX_CAMERA_CONSENT") ||
+      wm_xr_test_env_enabled("XRWB_INDEX_CAMERA_OVERLAY") ||
+      wm_xr_test_env_enabled("XRWB_INDEX_CAMERA_GESTURE") ||
+      wm_xr_test_env_enabled("XRWB_PHYSICAL_GESTURE_OPT_IN"))
+  {
+    return false;
+  }
+  wmWindowManager *wm = CTX_wm_manager(C);
+  return wm && WM_xr_session_is_ready(&wm->xr) &&
+         !(wm->xr.session_settings.draw_flags & V3D_OFSDRAW_XR_SHOW_PASSTHROUGH);
+}
+
+static wmOperatorStatus wm_xr_test_action_exec(bContext *C, wmOperator *op)
+{
+  /* Recheck the opt-in even for direct native exec calls which bypass polling. */
+  if (!wm_xr_test_action_poll(C)) {
+    return OPERATOR_CANCELLED;
+  }
+  wmWindowManager *wm = CTX_wm_manager(C);
+  wmXrRuntimeData *runtime = wm->xr.runtime;
+  wmWindow *win = wm_xr_session_root_window_or_fallback_get(wm, runtime);
+  wmXrActionSet *action_set = runtime->session_state.active_action_set;
+  if (!win || win != CTX_wm_window(C) || !runtime->area || !action_set ||
+      !STREQ(action_set->name, "xr_workbench_controllers"))
+  {
+    BKE_report(op->reports, RPT_ERROR, "The Workbench XR action set and off-screen area must be ready");
+    return OPERATOR_CANCELLED;
+  }
+
+  char action_name[64], user_path[64];
+  RNA_string_get(op->ptr, "action", action_name);
+  RNA_string_get(op->ptr, "user_path", user_path);
+  if (!STREQ(user_path, "/user/hand/left") && !STREQ(user_path, "/user/hand/right")) {
+    BKE_report(op->reports, RPT_ERROR, "A registered left or right hand path is required");
+    return OPERATOR_CANCELLED;
+  }
+  const wmXrAction *action = static_cast<wmXrAction *>(
+      GHOST_XrGetActionCustomdata(runtime->ghost_context, action_set->name, action_name));
+  if (!action || !action->ot || !ELEM(action->type, XR_BOOLEAN_INPUT, XR_FLOAT_INPUT)) {
+    BKE_report(op->reports, RPT_ERROR, "A registered Workbench button or scalar action is required");
+    return OPERATOR_CANCELLED;
+  }
+  uint hand = action->count_subaction_paths;
+  for (uint i = 0; i < action->count_subaction_paths; i++) {
+    if (STREQ(action->subaction_paths[i], user_path)) {
+      hand = i;
+      break;
+    }
+  }
+  if (hand == action->count_subaction_paths) {
+    BKE_report(op->reports, RPT_ERROR, "The action is not bound to the requested hand");
+    return OPERATOR_CANCELLED;
+  }
+  const int value = RNA_enum_get(op->ptr, "value");
+  float location[3], rotation[4];
+  RNA_float_get_array(op->ptr, "controller_location", location);
+  RNA_float_get_array(op->ptr, "controller_rotation", rotation);
+  double norm = 0.0;
+  for (const float component : location) {
+    if (!std::isfinite(component)) {
+      return OPERATOR_CANCELLED;
+    }
+  }
+  for (const float component : rotation) {
+    if (!std::isfinite(component)) {
+      return OPERATOR_CANCELLED;
+    }
+    norm += double(component) * component;
+  }
+  if (!ELEM(value, KM_PRESS, KM_RELEASE) || norm <= 1.0e-20) {
+    return OPERATOR_CANCELLED;
+  }
+  const double length = std::sqrt(norm);
+  for (float &component : rotation) {
+    component = float(component / length);
+  }
+
+  wmXrActionData *data = MEM_new_zeroed<wmXrActionData>(__func__);
+  STRNCPY(data->action_set, action_set->name);
+  STRNCPY(data->action, action->name);
+  STRNCPY(data->user_path, user_path);
+  data->type = action->type;
+  data->state[0] = value == KM_PRESS ? 1.0f : 0.0f;
+  if (action->type == XR_FLOAT_INPUT) {
+    data->float_threshold = action->float_thresholds[hand];
+    if (action->axis_flags[hand] & XR_AXIS0_NEG) {
+      data->state[0] = -data->state[0];
+    }
+  }
+  copy_v3_v3(data->controller_loc, location);
+  copy_qt_qt(data->controller_rot, rotation);
+  data->ot = action->ot;
+  data->op_properties = action->op_properties;
+  /* Use the real event queue and native invoke/modal routing. Do not call the
+   * operator directly or modify live runtime controller/pose/input state. */
+  wm_event_add_xrevent(win, data, short(value));
+  return OPERATOR_FINISHED;
+}
+
