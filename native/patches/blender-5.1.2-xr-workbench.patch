+static wmOperatorStatus editor_capture_exec(bContext *C, wmOperator *op)
+{
+  wmXrRuntimeData *runtime = CTX_wm_manager(C)->xr.runtime;
+  wmXrEditorSurface &surface = RNA_boolean_get(op->ptr, "hand_menu") ?
+      runtime->hand_menu.surface : runtime->editor_surface;
+  char path[sizeof(surface.capture_path)];
+  RNA_string_get(op->ptr, "filepath", path);
+  if (!surface.visible || !BLI_path_is_abs_from_cwd(path) ||
+      !BLI_path_extension_check(path, ".png")) {
+    return OPERATOR_CANCELLED;
+  }
+  STRNCPY(surface.capture_path, path);
+  WM_event_add_notifier(C, NC_WINDOW, nullptr);
+  return OPERATOR_FINISHED;
+}
