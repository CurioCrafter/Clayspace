@@ -0,0 +1,742 @@
+/* SPDX-FileCopyrightText: 2026 Blender Authors
+ * SPDX-License-Identifier: GPL-2.0-or-later */
+
+/* Opt-in, uncalibrated seated Index camera diagnostic. No scene input or disk capture. */
+#include <cstdlib>
+#include <cstring>
+
+#include "wm_xr_intern.hh"
+#include "wm_xr_camera_stream.hh"
+
+#ifdef _WIN32
+#  define WIN32_LEAN_AND_MEAN
+#  include <Windows.h>
+
+#  include <algorithm>
+#  include <array>
+#  include <atomic>
+#  include <chrono>
+#  include <cmath>
+#  include <cstdio>
+#  include <filesystem>
+#  include <mutex>
+#  include <new>
+#  include <string>
+#  include <thread>
+#  include <vector>
+
+#  include "BLF_api.hh"
+#  include "GHOST_Xr-api.hh"
+#  include "GPU_immediate.hh"
+#  include "GPU_matrix.hh"
+#  include "GPU_state.hh"
+#  include "GPU_texture.hh"
+
+namespace blender {
+namespace {
+using Clock = std::chrono::steady_clock;
+constexpr uint32_t kEyeSize = xr_camera::eye_size;
+constexpr size_t kEyeBytes = xr_camera::eye_bytes;
+constexpr size_t kStereoBytes = xr_camera::stereo_bytes;
+constexpr auto kCaptureLimit = std::chrono::minutes(5);
+constexpr auto kFrameFreshness = std::chrono::milliseconds(500);
+
+std::wstring env_w(const wchar_t *name)
+{
+  const DWORD length = GetEnvironmentVariableW(name, nullptr, 0);
+  if (length < 2 || length > 4096) {
+    return {};
+  }
+  std::wstring value(length, L'\0');
+  const DWORD actual = GetEnvironmentVariableW(name, value.data(), length);
+  if (actual == 0 || actual >= length) {
+    return {};
+  }
+  value.resize(actual);
+  return value;
+}
+
+bool valid_executable(const std::wstring &path)
+{
+  if (path.empty() || path.find(L'"') != std::wstring::npos) {
+    return false;
+  }
+  const std::filesystem::path file(path);
+  std::error_code error;
+  return file.is_absolute() && file.extension() == L".exe" &&
+         std::filesystem::is_regular_file(file, error) && !error;
+}
+
+bool valid_camera(const std::wstring &name)
+{
+  if (name.empty() || name.size() > 128) {
+    return false;
+  }
+  for (wchar_t c : name) {
+    if (!((c >= L'A' && c <= L'Z') || (c >= L'a' && c <= L'z') ||
+          (c >= L'0' && c <= L'9') || c == L'_' || c == L'-' || c == L' '))
+    {
+      return false;
+    }
+  }
+  return true;
+}
+
+void wipe(std::vector<unsigned char> &pixels)
+{
+  if (!pixels.empty()) {
+    SecureZeroMemory(pixels.data(), pixels.size());
+    pixels.clear();
+  }
+}
+
+struct CameraChild {
+  HANDLE pipe = nullptr;
+  HANDLE process = nullptr;
+  HANDLE job = nullptr;
+  DWORD start_error = 0;
+
+  ~CameraChild()
+  {
+    /* Kill-on-close owns the evaluator and its FFmpeg child even if Blender crashes. */
+    if (job) {
+      CloseHandle(job);
+    }
+    if (pipe) {
+      CloseHandle(pipe);
+    }
+    if (process) {
+      CloseHandle(process);
+    }
+  }
+
+  bool start(const std::wstring &exe,
+             const std::wstring &camera,
+             const std::wstring &ffmpeg,
+             bool gesture_mode)
+  {
+    SECURITY_ATTRIBUTES security{sizeof(security), nullptr, TRUE};
+    HANDLE writer = nullptr;
+    if (!CreatePipe(&pipe, &writer, &security, 64 * 1024)) {
+      start_error = GetLastError();
+      return false;
+    }
+    if (!SetHandleInformation(pipe, HANDLE_FLAG_INHERIT, 0)) {
+      start_error = GetLastError();
+      if (writer) {
+        CloseHandle(writer);
+      }
+      return false;
+    }
+    HANDLE null_output = CreateFileW(L"NUL", GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                                     &security, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    HANDLE null_input = CreateFileW(L"NUL", GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                                    &security, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    HANDLE inherited_error = nullptr;
+    const HANDLE blender_error = GetStdHandle(STD_ERROR_HANDLE);
+    if (blender_error && blender_error != INVALID_HANDLE_VALUE) {
+      DuplicateHandle(GetCurrentProcess(), blender_error, GetCurrentProcess(), &inherited_error,
+                      0, TRUE, DUPLICATE_SAME_ACCESS);
+    }
+    job = CreateJobObjectW(nullptr, nullptr);
+    JOBOBJECT_EXTENDED_LIMIT_INFORMATION limit{};
+    limit.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+    bool ready = null_output != INVALID_HANDLE_VALUE && null_input != INVALID_HANDLE_VALUE &&
+                 job && SetInformationJobObject(job, JobObjectExtendedLimitInformation,
+                                                &limit, sizeof(limit));
+    if (!ready) {
+      start_error = GetLastError();
+    }
+    PROCESS_INFORMATION info{};
+    if (ready) {
+      STARTUPINFOW startup{};
+      startup.cb = sizeof(startup);
+      startup.dwFlags = STARTF_USESTDHANDLES;
+      startup.hStdInput = null_input;
+      startup.hStdOutput = writer;
+      /* Forward text diagnostics to Blender's already-drained stderr; stdout stays binary. */
+      startup.hStdError = inherited_error ? inherited_error : null_output;
+      std::wstring command = L"\"" + exe +
+                             (gesture_mode ? L"\" --consented-stereo-packet-stream \"" :
+                                             L"\" --consented-stream-rgba \"") + camera +
+                             L"\" \"" + ffmpeg + L"\"";
+      ready = CreateProcessW(exe.c_str(), command.data(), nullptr, nullptr, TRUE,
+                             CREATE_NO_WINDOW | CREATE_SUSPENDED, nullptr, nullptr, &startup, &info);
+      if (!ready) {
+        start_error = GetLastError();
+      }
+      if (ready) {
+        ready = AssignProcessToJobObject(job, info.hProcess) &&
+                ResumeThread(info.hThread) != DWORD(-1);
+        if (!ready) {
+          start_error = GetLastError();
+          TerminateProcess(info.hProcess, 1);
+        }
+        process = info.hProcess;
+        CloseHandle(info.hThread);
+      }
+    }
+    CloseHandle(writer);
+    if (null_output != INVALID_HANDLE_VALUE) {
+      CloseHandle(null_output);
+    }
+    if (null_input != INVALID_HANDLE_VALUE) {
+      CloseHandle(null_input);
+    }
+    if (inherited_error) {
+      CloseHandle(inherited_error);
+    }
+    return ready;
+  }
+};
+
+bool read_exact(const CameraChild &child,
+                const std::atomic<bool> &stop,
+                unsigned char *out,
+                size_t size,
+                const Clock::time_point deadline)
+{
+  size_t done = 0;
+  while (done < size && !stop.load() && Clock::now() < deadline) {
+    DWORD available = 0;
+    if (!PeekNamedPipe(child.pipe, nullptr, 0, nullptr, &available, nullptr)) {
+      return false;
+    }
+    if (!available) {
+      if (WaitForSingleObject(child.process, 0) == WAIT_OBJECT_0) {
+        return false;
+      }
+      Sleep(2);
+      continue;
+    }
+    DWORD read = 0;
+    const DWORD wanted = DWORD(std::min<size_t>(size - done, available));
+    if (!ReadFile(child.pipe, out + done, wanted, &read, nullptr) || read == 0) {
+      return false;
+    }
+    done += read;
+  }
+  return done == size;
+}
+
+}  // namespace
+
+struct GestureSummary {
+  uint32_t sequence = 0;
+  uint32_t candidate = 0;
+  uint32_t source_age_ms = 0;
+  float presence = 0;
+  float palm_score = 0;
+  float xy[8]{}; /* Thumb tip, index tip, index MCP, pinky MCP. */
+  bool valid = false;
+};
+
+struct wmXrCameraOverlay {
+  std::atomic<bool> stop{false};
+  std::atomic<bool> finished{false};
+  std::atomic<int64_t> deadline_ns{0};
+  std::atomic<uint32_t> eye_draws{0};
+  std::atomic<uint32_t> stale_events{0};
+  std::mutex mutex;
+  std::vector<unsigned char> published;
+  Clock::time_point published_at{};
+  uint32_t published_sequence = 0;
+  GestureSummary published_gesture;
+  std::vector<unsigned char> current;
+  Clock::time_point current_at{};
+  uint32_t current_sequence = 0;
+  GestureSummary current_gesture;
+  uint32_t uploaded_sequence = 0;
+  std::atomic<uint32_t> displayed_sequence{0};
+  bool stale_reported = false;
+  bool gesture_mode = false;
+  gpu::Texture *eye_texture[2]{};
+  std::thread reader;
+
+  wmXrCameraOverlay(const std::wstring &exe,
+                    const std::wstring &camera,
+                    const std::wstring &ffmpeg,
+                    bool with_gestures)
+      : gesture_mode(with_gestures)
+  {
+    reader = std::thread([this, exe, camera, ffmpeg] {
+      try {
+        read_stream(exe, camera, ffmpeg);
+      }
+      catch (...) {
+        /* Allocation or stream exceptions must not terminate Blender's XR session. */
+        stop.store(true);
+        {
+          std::lock_guard lock(mutex);
+          wipe(published);
+        }
+        finished.store(true);
+        std::puts("XR_INDEX_CAMERA_OVERLAY_END reason=reader_exception camera=off "
+                  "images_saved=0 joint_traces_saved=0");
+        std::fflush(stdout);
+      }
+    });
+  }
+
+  ~wmXrCameraOverlay()
+  {
+    stop.store(true);
+    if (reader.joinable()) {
+      reader.join();
+    }
+    clear_textures();
+    wipe(published);
+    wipe(current);
+  }
+
+  void clear_textures()
+  {
+    for (gpu::Texture *&texture : eye_texture) {
+      if (texture) {
+        GPU_texture_free(texture);
+        texture = nullptr;
+      }
+    }
+    uploaded_sequence = 0;
+  }
+
+  void read_stream(const std::wstring &exe,
+                   const std::wstring &camera,
+                   const std::wstring &ffmpeg)
+  {
+    CameraChild child;
+    const char *reason = "stream_error";
+    uint32_t frames = 0, dropped_packets = 0, stale_source_drops = 0, qualified_records = 0;
+    uint64_t contours_left = 0, contours_right = 0;
+    if (!child.start(exe, camera, ffmpeg, gesture_mode)) {
+      reason = "child_start_failed";
+    }
+    else {
+      const Clock::time_point deadline = Clock::now() + kCaptureLimit;
+      deadline_ns.store(std::chrono::duration_cast<std::chrono::nanoseconds>(
+                            deadline.time_since_epoch()).count());
+      std::vector<unsigned char> pixels(kStereoBytes);
+      uint32_t last_source_sequence = 0;
+      while (!stop.load() && Clock::now() < deadline) {
+        uint32_t contour_count[2]{};
+        GestureSummary gesture;
+        if (gesture_mode) {
+          std::array<unsigned char, xr_camera::packet_header_bytes> header{};
+          if (!read_exact(child, stop, header.data(), header.size(), deadline)) {
+            break;
+          }
+          if (!xr_camera::valid_packet_header(header)) {
+            reason = "invalid_packet";
+            break;
+          }
+          const auto word = [&](size_t index) {
+            return xr_camera::read_u32_le(header.data() + index * 4);
+          };
+          const uint32_t source_sequence = word(5);
+          if (frames && source_sequence <= last_source_sequence) {
+            reason = "nonmonotonic_packet";
+            break;
+          }
+          last_source_sequence = source_sequence;
+          contour_count[0] = word(9);
+          contour_count[1] = word(10);
+          gesture.sequence = source_sequence;
+          gesture.source_age_ms = word(14);
+          if (!read_exact(child, stop, pixels.data(), pixels.size(), deadline)) {
+            break;
+          }
+          int left_records = 0;
+          bool records_complete = true;
+          bool invalid_record = false;
+          for (uint32_t i = 0; i < word(8); i++) {
+            std::array<unsigned char, xr_camera::packet_record_bytes> record{};
+            if (!read_exact(child, stop, record.data(), record.size(), deadline)) {
+              records_complete = false;
+              break;
+            }
+            const uint32_t view = xr_camera::read_u32_le(record.data());
+            if (view > 1u || xr_camera::read_u32_le(record.data() + 4) > 1u) {
+              invalid_record = true;
+            }
+            if (view != 0u) {
+              continue;
+            }
+            left_records++;
+            gesture.candidate = xr_camera::read_u32_le(record.data() + 4);
+            gesture.presence = xr_camera::read_f32_le(record.data() + 8);
+            gesture.palm_score = xr_camera::read_f32_le(record.data() + 12);
+            constexpr int points[4] = {4, 8, 5, 17};
+            bool points_valid = true;
+            for (int point = 0; point < 4; point++) {
+              for (int axis = 0; axis < 2; axis++) {
+                const float value = xr_camera::read_f32_le(
+                    record.data() + 16 + (points[point] * 2 + axis) * 4);
+                gesture.xy[point * 2 + axis] = value;
+                points_valid &= std::isfinite(value) && value >= 0 && value < kEyeSize;
+              }
+            }
+            gesture.valid = points_valid && gesture.candidate < 2 &&
+                            std::isfinite(gesture.presence) && gesture.presence >= 0.8f &&
+                            std::isfinite(gesture.palm_score) && gesture.palm_score >= 0.5f;
+          }
+          if (!records_complete) {
+            break;
+          }
+          if (invalid_record) {
+            reason = "invalid_record";
+            break;
+          }
+          const uint64_t received_ns = uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(
+              Clock::now().time_since_epoch()).count());
+          const uint64_t captured_ns = xr_camera::read_u64_le(header.data() + 64);
+          if (!xr_camera::fresh_capture(captured_ns, received_ns)) {
+            stale_source_drops++;
+            continue;
+          }
+          gesture.source_age_ms = uint32_t((received_ns - captured_ns) / 1000000u);
+          gesture.valid &= left_records == 1;
+        }
+        else {
+          std::array<uint32_t, 6> header{};
+          if (!read_exact(child, stop, reinterpret_cast<unsigned char *>(header.data()),
+                          sizeof(header), deadline))
+          {
+            break;
+          }
+          if (!xr_camera::valid_header(header)) {
+            reason = "invalid_packet";
+            break;
+          }
+          contour_count[0] = header[4];
+          contour_count[1] = header[5];
+          if (!read_exact(child, stop, pixels.data(), pixels.size(), deadline)) {
+            break;
+          }
+        }
+        {
+          std::lock_guard lock(mutex);
+          if (published_sequence != current_sequence) {
+            dropped_packets++;
+          }
+          pixels.swap(published);
+          published_at = Clock::now();
+          published_sequence++;
+          published_gesture = gesture;
+        }
+        frames++;
+        qualified_records += gesture.valid;
+        contours_left += contour_count[0];
+        contours_right += contour_count[1];
+        if (pixels.size() != kStereoBytes) {
+          pixels.resize(kStereoBytes);
+        }
+      }
+      if (Clock::now() >= deadline) {
+        reason = "5m_safety_limit";
+      }
+      else if (stop.load()) {
+        reason = "session_end";
+      }
+      wipe(pixels);
+    }
+    {
+      std::lock_guard lock(mutex);
+      wipe(published);
+    }
+    finished.store(true);
+    DWORD child_exit = 0;
+    const bool child_still_running = child.process &&
+                                     WaitForSingleObject(child.process, 0) == WAIT_TIMEOUT;
+    if (child.process && !GetExitCodeProcess(child.process, &child_exit)) {
+      child_exit = GetLastError();
+    }
+    std::printf("XR_INDEX_CAMERA_OVERLAY_END reason=%s frames=%u dropped_packets=%u stale_source_drops=%u "
+                "eye_draws=%u stale_events=%u contours_left=%llu contours_right=%llu "
+                "qualified_records=%u gesture_mode=%d "
+                "start_error=%lu child_exit=%lu child_still_running=%d "
+                "latest_only=1 capture_age_unavailable=1 "
+                "images_saved=0 joint_traces_saved=0\n",
+                reason, frames, dropped_packets, stale_source_drops, eye_draws.load(), stale_events.load(),
+                static_cast<unsigned long long>(contours_left),
+                static_cast<unsigned long long>(contours_right), qualified_records,
+                int(gesture_mode), child.start_error, child_exit,
+                int(child_still_running));
+    std::fflush(stdout);
+  }
+
+  bool update_for_eye(int view_index)
+  {
+    const int64_t deadline = deadline_ns.load();
+    const int64_t now = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                            Clock::now().time_since_epoch())
+                            .count();
+    if (finished.load() || (deadline != 0 && now >= deadline)) {
+      stop.store(true);
+      clear_textures();
+      wipe(current);
+      return false;
+    }
+    if (view_index == 0 && mutex.try_lock()) {
+      if (published_sequence != current_sequence && published.size() == kStereoBytes) {
+        published.swap(current);
+        current_at = published_at;
+        current_sequence = published_sequence;
+        current_gesture = published_gesture;
+        stale_reported = false;
+      }
+      mutex.unlock();
+    }
+    if (current.size() != kStereoBytes || Clock::now() - current_at > kFrameFreshness) {
+      if (current_sequence && !stale_reported) {
+        stale_events++;
+        stale_reported = true;
+      }
+      clear_textures();
+      wipe(current);
+      return false;
+    }
+    if (view_index == 0 && uploaded_sequence != current_sequence) {
+      for (int eye = 0; eye < 2; eye++) {
+        if (!eye_texture[eye]) {
+          eye_texture[eye] = GPU_texture_create_2d("Index camera seated diagnostic",
+                                                  kEyeSize, kEyeSize, 1,
+                                                  gpu::TextureFormat::UNORM_8_8_8_8,
+                                                  GPU_TEXTURE_USAGE_SHADER_READ, nullptr);
+        }
+        if (!eye_texture[eye]) {
+          clear_textures();
+          stop.store(true);
+          return false;
+        }
+        GPU_texture_update(eye_texture[eye], GPU_DATA_UBYTE, current.data() + eye * kEyeBytes);
+        GPU_texture_filter_mode(eye_texture[eye], true);
+      }
+      uploaded_sequence = current_sequence;
+    }
+    return view_index >= 0 && view_index < 2 && eye_texture[view_index] != nullptr;
+  }
+
+  void observation(float values[14])
+  {
+    std::fill_n(values, 14, 0.0f);
+    if (!gesture_mode || finished.load() || stop.load()) {
+      return;
+    }
+    std::lock_guard lock(mutex);
+    const auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(
+                             Clock::now() - current_at)
+                             .count();
+    const int64_t age = int64_t(current_gesture.source_age_ms) + elapsed;
+    if (!current_gesture.valid || current_sequence == 0 ||
+        displayed_sequence.load() != current_sequence || age < 0 || age > 500)
+    {
+      return;
+    }
+    values[0] = 1.0f;
+    values[1] = float(current_gesture.sequence);
+    values[2] = float(current_gesture.candidate);
+    values[3] = current_gesture.presence;
+    values[4] = current_gesture.palm_score;
+    std::copy_n(current_gesture.xy, 8, values + 5);
+    values[13] = float(age);
+  }
+};
+
+void wm_xr_camera_overlay_observation(wmXrCameraOverlay *overlay, float values[14])
+{
+  std::fill_n(values, 14, 0.0f);
+  if (overlay) {
+    overlay->observation(values);
+  }
+}
+
+bool wm_xr_camera_overlay_requested()
+{
+  const char *requested = std::getenv("XRWB_INDEX_CAMERA_OVERLAY");
+  return requested && std::strcmp(requested, "1") == 0;
+}
+
+void wm_xr_camera_overlay_draw(wmXrSurfaceData *surface_data,
+                               const GHOST_XrDrawViewInfo *draw_view,
+                               const wmXrRuntimeData *runtime)
+{
+  if (!wm_xr_camera_overlay_requested() || draw_view->view_idx < 0 ||
+      draw_view->view_idx > 1)
+  {
+    return;
+  }
+  /* A seated diagnostic requires an active compositor, not Lighthouse 6DoF pose validity. */
+  if (!GHOST_XrSessionIsRunning(runtime->ghost_context)) {
+    if (surface_data->camera_overlay) {
+      surface_data->camera_overlay->stop.store(true);
+      surface_data->camera_overlay->clear_textures();
+    }
+    return;
+  }
+  if (!surface_data->camera_overlay) {
+    const std::wstring exe = env_w(L"XRWB_INDEX_CAMERA_EVAL");
+    const std::wstring ffmpeg = env_w(L"XRWB_INDEX_CAMERA_FFMPEG");
+    const std::wstring camera = env_w(L"XRWB_INDEX_CAMERA_NAME");
+    if (env_w(L"XRWB_INDEX_CAMERA_CONSENT") != L"1" || !valid_executable(exe) ||
+        !valid_executable(ffmpeg) || !valid_camera(camera))
+    {
+      static bool refused = false;
+      if (!refused) {
+        std::puts("XR_INDEX_CAMERA_OVERLAY_REFUSED reason=missing_consent_or_invalid_config camera=off");
+        std::fflush(stdout);
+        refused = true;
+      }
+      return;
+    }
+    try {
+      surface_data->camera_overlay = new wmXrCameraOverlay(
+          exe, camera, ffmpeg, env_w(L"XRWB_INDEX_CAMERA_GESTURE") == L"1");
+      std::puts("XR_INDEX_CAMERA_OVERLAY_START uncalibrated_seated_camera_diagnostic=1 "
+                "safety_limit_seconds=300 latest_only=1 capture_age_unavailable=1 "
+                "images_saved=0 joint_traces_saved=0");
+      std::fflush(stdout);
+    }
+    catch (...) {
+      std::puts("XR_INDEX_CAMERA_OVERLAY_REFUSED reason=reader_allocation_failed camera=off");
+      std::fflush(stdout);
+      return;
+    }
+  }
+  wmXrCameraOverlay &overlay = *surface_data->camera_overlay;
+  if (!overlay.update_for_eye(draw_view->view_idx)) {
+    return;
+  }
+  const int font = BLF_default();
+  const bool upside_down = GHOST_XrSessionNeedsUpsideDownDrawing(runtime->ghost_context);
+  const float y_bottom = upside_down ? 0.0f : 1.0f;
+  const float y_top = 1.0f - y_bottom;
+  const GPUBlend old_blend = GPU_blend_get();
+  const GPUDepthTest old_depth = GPU_depth_test_get();
+  GPU_matrix_push();
+  GPU_matrix_push_projection();
+  GPU_matrix_identity_set();
+  GPU_matrix_ortho_set(0, draw_view->width, 0, draw_view->height, -1, 1);
+  GPU_depth_test(GPU_DEPTH_NONE);
+  GPU_blend(GPU_BLEND_ALPHA);
+  GPUVertFormat *format = immVertexFormat();
+  const uint pos = GPU_vertformat_attr_add(format, "pos", gpu::VertAttrType::SFLOAT_32_32_32);
+  const uint uv = GPU_vertformat_attr_add(format, "texCoord", gpu::VertAttrType::SFLOAT_32_32);
+  gpu::Texture *texture = overlay.eye_texture[draw_view->view_idx];
+  GPU_texture_bind(texture, 0);
+  immBindBuiltinProgram(GPU_SHADER_3D_IMAGE_COLOR);
+  immUniform1i("image", 0);
+  /* Camera dominates the already-drawn scene and panels; native HUD follows. */
+  immUniformColor4f(1.0f, 1.0f, 1.0f, 0.90f);
+  immBegin(GPU_PRIM_TRI_FAN, 4);
+  immAttr2f(uv, 0.0f, y_bottom);
+  immVertex3f(pos, 0, 0, 0);
+  immAttr2f(uv, 1.0f, y_bottom);
+  immVertex3f(pos, draw_view->width, 0, 0);
+  immAttr2f(uv, 1.0f, y_top);
+  immVertex3f(pos, draw_view->width, draw_view->height, 0);
+  immAttr2f(uv, 0.0f, y_top);
+  immVertex3f(pos, 0, draw_view->height, 0);
+  immEnd();
+  immUnbindProgram();
+  GPU_texture_unbind(texture);
+  /* A small, central live indicator proves this eye's draw target is visible
+   * even if the camera image is dark or the hand detector has no contours. */
+  const float marker_x = draw_view->width * 0.5f;
+  const float marker_y = draw_view->height * 0.76f;
+  const float marker_w = draw_view->width * 0.045f;
+  const float marker_h = draw_view->height * 0.012f;
+  const uint marker_pos = GPU_vertformat_attr_add(
+      immVertexFormat(), "pos", gpu::VertAttrType::SFLOAT_32_32_32);
+  immBindBuiltinProgram(GPU_SHADER_3D_UNIFORM_COLOR);
+  immUniformColor4f(0.05f, 0.85f, 1.0f, 1.0f);
+  immBegin(GPU_PRIM_TRI_FAN, 4);
+  immVertex3f(marker_pos, marker_x - marker_w, marker_y - marker_h, 0.0f);
+  immVertex3f(marker_pos, marker_x + marker_w, marker_y - marker_h, 0.0f);
+  immVertex3f(marker_pos, marker_x + marker_w, marker_y + marker_h, 0.0f);
+  immVertex3f(marker_pos, marker_x - marker_w, marker_y + marker_h, 0.0f);
+  immEnd();
+  immUnbindProgram();
+  if (overlay.gesture_mode) {
+    /* The button is composed in the same raw eye-image coordinates returned
+     * to Python; it is not a guessed ray onto the spatial task card. */
+    const float hud_x0 = draw_view->width * (340.0f / kEyeSize);
+    const float hud_x1 = draw_view->width * (620.0f / kEyeSize);
+    const auto hud_y = [&](float camera_y) {
+      return draw_view->height *
+             ((camera_y / kEyeSize - y_bottom) / (y_top - y_bottom));
+    };
+    const float hud_y0 = std::min(hud_y(700.0f), hud_y(850.0f));
+    const float hud_y1 = std::max(hud_y(700.0f), hud_y(850.0f));
+    const bool hover = overlay.current_gesture.valid &&
+                       overlay.current_gesture.xy[2] >= 340.0f &&
+                       overlay.current_gesture.xy[2] <= 620.0f &&
+                       overlay.current_gesture.xy[3] >= 700.0f &&
+                       overlay.current_gesture.xy[3] <= 850.0f;
+    const uint hud_pos = GPU_vertformat_attr_add(
+        immVertexFormat(), "pos", gpu::VertAttrType::SFLOAT_32_32_32);
+    immBindBuiltinProgram(GPU_SHADER_3D_UNIFORM_COLOR);
+    immUniformColor4f(hover ? 0.03f : 0.01f, hover ? 0.46f : 0.20f,
+                      hover ? 0.60f : 0.34f, 0.88f);
+    immBegin(GPU_PRIM_TRI_FAN, 4);
+    immVertex3f(hud_pos, hud_x0, hud_y0, 0.0f);
+    immVertex3f(hud_pos, hud_x1, hud_y0, 0.0f);
+    immVertex3f(hud_pos, hud_x1, hud_y1, 0.0f);
+    immVertex3f(hud_pos, hud_x0, hud_y1, 0.0f);
+    immEnd();
+    immUnbindProgram();
+    if (font >= 0) {
+      BLF_size(font, 36);
+      BLF_color4f(font, 1.0f, 1.0f, 1.0f, 1.0f);
+      BLF_position(font, hud_x0 + 20.0f, hud_y0 + 28.0f, 0.1f);
+      BLF_draw(font, "ADD CUBE", 8);
+      BLF_batch_draw_flush();
+    }
+  }
+  if (font >= 0) {
+    const int64_t remaining_ns = overlay.deadline_ns.load() -
+        std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now().time_since_epoch()).count();
+    const int remaining_seconds = int(std::max<int64_t>(0, (remaining_ns + 999999999) / 1000000000));
+    char label[96];
+    std::snprintf(label, sizeof(label), "UNCALIBRATED SEATED CAMERA DIAGNOSTIC  %ds",
+                  remaining_seconds);
+    BLF_size(font, 22);
+    BLF_color4f(font, 1.0f, 0.95f, 0.5f, 1.0f);
+    BLF_position(font, 24.0f, 36.0f, 0.1f);
+    BLF_draw(font, label, std::strlen(label));
+    BLF_batch_draw_flush();
+  }
+  GPU_blend(old_blend);
+  GPU_depth_test(old_depth);
+  GPU_matrix_pop_projection();
+  GPU_matrix_pop();
+  overlay.eye_draws++;
+  if (draw_view->view_idx == 1) {
+    overlay.displayed_sequence.store(overlay.current_sequence);
+  }
+}
+
+void wm_xr_camera_overlay_free(wmXrSurfaceData *surface_data)
+{
+  delete surface_data->camera_overlay;
+  surface_data->camera_overlay = nullptr;
+}
