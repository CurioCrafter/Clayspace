+
+/* RNA uses signed 32-bit components. Reject unrepresentable OpenXR times rather
+ * than publishing wrapped time alongside apparently usable joint coordinates. */
+static bool wm_xr_hand_timestamp_split(int64_t timestamp_ns, int &seconds, int &nanoseconds)
+{
+  const int64_t whole_seconds = timestamp_ns / 1000000000;
+  if (whole_seconds < INT32_MIN || whole_seconds > INT32_MAX) {
+    seconds = nanoseconds = 0;
+    return false;
+  }
+  seconds = int(whole_seconds);
+  nanoseconds = int(timestamp_ns % 1000000000);
+  return true;
+}
+
+void WM_xr_hand_tracking_info(const wmXrData *xr, int hand, int r_values[6])
+{
+  memset(r_values, 0, sizeof(int) * 6);
+  if (!xr || !xr->runtime) {
+    return;
+  }
+  GHOST_XrHandSample sample;
+  GHOST_XrHandSampleGet(xr->runtime->ghost_context, hand, &sample);
+  r_values[0] = sample.available;
+  const bool time_valid = wm_xr_hand_timestamp_split(sample.timestamp_ns, r_values[3], r_values[4]);
+  r_values[1] = time_valid && sample.active && xr->runtime->session_state.is_view_data_set;
+  r_values[2] = sample.data_source;
+  r_values[5] = int(sample.generation);
+}
+
+static bool wm_xr_hand_world_transform(const wmXrData *xr, float matrix[4][4], float &scale)
+{
+  if (!xr || !xr->runtime || !xr->runtime->session_state.is_view_data_set) {
+    return false;
+  }
+  const wmXrSessionState *state = &xr->runtime->session_state;
+  const XrSessionSettings *settings = &xr->session_settings;
+  scale = state->prev_base_scale * state->viewer_scale;
+  if (!std::isfinite(scale) || scale <= 0) {
+    return false;
+  }
+  float view_ofs[3] = {}, base_mat[4][4], nav_mat[4][4], offset[4][4], base_offset[4][4];
+  if ((settings->flag & XR_SESSION_USE_POSITION_TRACKING) == 0) {
+    copy_v3_v3(view_ofs, state->prev_local_pose.position);
+  }
+  if ((settings->flag & XR_SESSION_USE_ABSOLUTE_TRACKING) == 0) {
+    add_v3_v3(view_ofs, state->prev_eye_position_ofs);
+  }
+  wm_xr_pose_scale_to_mat(&state->prev_base_pose, state->prev_base_scale, base_mat);
+  wm_xr_pose_scale_to_mat(&state->nav_pose, state->viewer_scale, nav_mat);
+  unit_m4(offset);
+  negate_v3_v3(offset[3], view_ofs);
+  mul_m4_m4m4(base_offset, base_mat, offset);
+  mul_m4_m4m4(matrix, nav_mat, base_offset);
+  for (int column = 0; column < 4; column++) {
+    for (int row = 0; row < 4; row++) {
+      if (!std::isfinite(matrix[column][row])) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+void WM_xr_hand_world_transform(const wmXrData *xr, float r_values[17])
+{
+  memset(r_values, 0, sizeof(float) * 17);
+  float matrix[4][4], scale;
+  if (wm_xr_hand_world_transform(xr, matrix, scale)) {
+    r_values[0] = scale;
+    memcpy(r_values + 1, matrix, sizeof(matrix));
+  }
+}
+
+void WM_xr_hand_joint_sample(const wmXrData *xr, int hand, int joint, float r_values[9])
+{
+  memset(r_values, 0, sizeof(float) * 9);
+  if (!xr || !xr->runtime || joint < 0 || joint >= 26) {
+    return;
+  }
+  const wmXrSessionState *state = &xr->runtime->session_state;
+  if (!state->is_view_data_set) {
+    return;
+  }
+  GHOST_XrHandSample sample;
+  GHOST_XrHandSampleGet(xr->runtime->ghost_context, hand, &sample);
+  int seconds, nanoseconds;
+  if (!sample.active || sample.data_source != 1 ||
+      !wm_xr_hand_timestamp_split(sample.timestamp_ns, seconds, nanoseconds))
+  {
