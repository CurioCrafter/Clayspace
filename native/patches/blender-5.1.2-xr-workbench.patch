+                                  const int mode,
+                                  const float duration,
+                                  const float start_factor,
+                                  const float threshold)
+{
+  if (!std::isfinite(delta_time) || delta_time < 0.0 || delta_time > 0.25 ||
+      !std::isfinite(input[0]) || !std::isfinite(input[1]) ||
+      !std::isfinite(duration) || duration <= 0.0f || !std::isfinite(start_factor) ||
+      !std::isfinite(threshold))
+  {
+    hold = {};
+    delta_time = 0.0;
+    return 0.0f;
+  }
+  delta_time = std::min(delta_time, 0.05);
+  const float magnitude = std::hypot(input[0], input[1]);
+  const bool reversed = input[0] * hold.input_prev[0] + input[1] * hold.input_prev[1] < 0.0f;
+  if (mode != hold.mode_prev || reversed || magnitude < std::clamp(threshold, 0.0f, 1.0f)) {
+    hold.elapsed = 0.0;
+  }
+  if (magnitude >= std::clamp(threshold, 0.0f, 1.0f)) {
+    hold.elapsed = std::min(hold.elapsed + delta_time, double(duration));
