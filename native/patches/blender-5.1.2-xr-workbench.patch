+  hold.input_prev[0] = input[0];
+  hold.input_prev[1] = input[1];
+  hold.mode_prev = mode;
+  const float t = float(hold.elapsed / double(duration));
+  const float eased = t * t * (3.0f - 2.0f * t);
+  const float start = std::clamp(start_factor, 0.0f, 1.0f);
+  return start + (1.0f - start) * eased;
