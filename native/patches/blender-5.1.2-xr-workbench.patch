+  RNA_def_string(ot->srna, "action", "pointer", 64, "Action", "Existing Workbench action name");
+  RNA_def_string(ot->srna, "user_path", "/user/hand/right", 64, "Hand", "Registered hand path");
+  RNA_def_enum(ot->srna, "value", values, KM_PRESS, "Value", "");
+  RNA_def_float_vector(ot->srna, "controller_location", 3, nullptr, -FLT_MAX, FLT_MAX,
+                       "Controller Location", "World-space aim origin", -1000.0f, 1000.0f);
+  RNA_def_float_vector(ot->srna, "controller_rotation", 4, rotation, -FLT_MAX, FLT_MAX,
