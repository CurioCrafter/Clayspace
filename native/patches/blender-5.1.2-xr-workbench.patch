+static void task_rect(float xmin, float ymin, float xmax, float ymax,
+                      float r, float g, float b, float alpha)
+{
+  /* BLF flush resets blending; each primitive restores the card's alpha policy. */
+  GPU_blend(GPU_BLEND_ALPHA);
+  const uint pos = GPU_vertformat_attr_add(
+      immVertexFormat(), "pos", gpu::VertAttrType::SFLOAT_32_32_32);
+  immBindBuiltinProgram(GPU_SHADER_3D_UNIFORM_COLOR);
+  immUniformColor4f(r, g, b, alpha);
+  immBegin(GPU_PRIM_TRI_FAN, 4);
+  immVertex3f(pos, xmin, ymin, 0);
+  immVertex3f(pos, xmax, ymin, 0);
+  immVertex3f(pos, xmax, ymax, 0);
+  immVertex3f(pos, xmin, ymax, 0);
+  immEnd();
+  immUnbindProgram();
+}
+
+static void task_text(int font, float x, float y, float size, const char *text)
+{
+  BLF_size(font, size);
+  BLF_color4f(font, 1, 1, 1, 1);
+  BLF_position(font, x, y, 0.1f);
+  BLF_draw(font, text, strlen(text));
+  BLF_batch_draw_flush();
+}
+
+static int task_next_generation()
+{
+  static int generation = 0;
+  generation = generation == INT_MAX ? 1 : generation + 1;
+  return generation;
+}
+
+void wm_xr_task_card_draw(const wmXrDrawData *data,
+                         const float viewmat[4][4], const float winmat[4][4])
+{
+  wmXrRuntimeData &runtime = *data->xr_data->runtime;
+  xr_task::State &card = runtime.task_card;
+  if (!card.visible || runtime.task_card_width <= 0 || !runtime.task_card_font_plus_one) {
+    return;
+  }
+  float model[4][4], projection[4][4];
+  wm_xr_pose_to_mat(&runtime.task_card_pose, model);
+  copy_m4_m4(projection, winmat);
+  const char *test_allow = std::getenv("XRWB_TASK_TEST_ALLOW");
+  if (test_allow && strcmp(test_allow, "1") == 0 && card.drawn_generation != card.generation) {
+    float model_view[4][4];
+    mul_m4_m4m4(model_view, viewmat, model);
+    printf("XR_TASK_BASIS origin_view=%.6f,%.6f,%.6f right_view=%.6f,%.6f,%.6f up_view=%.6f,%.6f,%.6f projection_xy=%.6f,%.6f\n",
+           model_view[3][0], model_view[3][1], model_view[3][2],
+           model_view[0][0], model_view[0][1], model_view[0][2],
+           model_view[1][0], model_view[1][1], model_view[1][2],
+           projection[0][0], projection[1][1]);
+    fflush(stdout);
+    const float *saved = runtime.task_card_pose.orientation_quat;
+    const float *current = runtime.session_state.viewer_pose.orientation_quat;
+    printf("XR_TASK_POSE saved_q=%.6f,%.6f,%.6f,%.6f current_q=%.6f,%.6f,%.6f,%.6f\n",
+           saved[0], saved[1], saved[2], saved[3], current[0], current[1], current[2], current[3]);
+    fflush(stdout);
+  }
+  if (GHOST_XrSessionNeedsUpsideDownDrawing(runtime.ghost_context)) {
+    for (int column = 0; column < 4; column++) {
+      projection[column][1] = -projection[column][1];
+    }
+  }
+  GPU_matrix_push();
+  GPU_matrix_push_projection();
+  GPU_matrix_set(viewmat);
+  GPU_matrix_mul(model);
+  const float scale = runtime.task_card_width / 1000.0f;
+  GPU_matrix_scale_3f(scale, scale, scale);
+  GPU_matrix_translate_3f(-500, -250, 0);
+  GPU_matrix_projection_set(projection);
+  const GPUBlend old_blend = GPU_blend_get();
+  const GPUDepthTest old_depth = GPU_depth_test_get();
+  GPU_depth_test(GPU_DEPTH_NONE);
+  GPU_blend(GPU_BLEND_ALPHA);
+  task_rect(0, 0, 1000, 500, .025f, .04f, .065f, card.opacity_percent / 100.0f);
+  const int font = runtime.task_card_font_plus_one - 1;
+  task_text(font, 60, 402, 44, card.arrange ? "XR Workbench / Arrange" :
+                                      "XR Workbench / Session");
+  if (card.arrange) {
+    task_text(font, 60, 345, 24, "Object hand tools");
+  }
+  const xr_task::Action *actions = card.arrange ? xr_task::arrange_actions :
+                                                 xr_task::session_actions;
+  const int action_count = card.arrange ? std::size(xr_task::arrange_actions) :
+                                          std::size(xr_task::session_actions);
+  for (int i = 0; i < action_count; i++) {
+    const xr_task::Action &action = actions[i];
+    const bool available = xr_task::enabled(card, action);
+    const bool selected = card.hover_action == action.id || card.captured_action == action.id;
+    task_rect(action.xmin, action.ymin, action.xmax, action.ymax,
+              !available ? .045f : selected ? .10f : .06f,
+              !available ? .055f : selected ? .32f : .13f,
+              !available ? .07f : selected ? .43f : .20f,
+              card.opacity_percent / 100.0f);
+    const bool page_switch = action.id == 3 || action.id == 4 || action.id == 13;
+    task_text(font, action.xmin + 20,
+              action.ymin + (action.id == 13 ? 45 : page_switch ? 17 : card.arrange ? 58 : 78),
+              page_switch ? 26 : card.arrange ? 30 : 36, action.label);
+    if (!available) {
+      task_text(font, action.xmin + 20, action.ymin + (action.id == 13 ? 12 : 23), 17,
+                action.unavailable_reason ? action.unavailable_reason :
+                action.id == 13 ? "No active edit" :
+                action.id == 9 ? "Needs Object Mode + idle edit" :
+                action.id == 11 ? "No undo step or edit active" :
+                action.id == 12 ? "No redo step or edit active" :
+                                 "XR Workbench add-on unavailable");
+    }
+  }
+  if (card.image_cursor_visible) {
+    const float x = card.image_cursor_x, y = card.image_cursor_y;
+    task_rect(x - 9, y - 9, x + 9, y + 9, .02f, .02f, .03f, 1.0f);
+    task_rect(x - 5, y - 5, x + 5, y + 5, .98f, .85f, .22f, 1.0f);
+  }
+  task_text(font, 60, 23, 20, "Point, pinch, release. Desktop remains available.");
+  GPU_blend(old_blend);
+  GPU_depth_test(old_depth);
+  GPU_matrix_pop_projection();
+  GPU_matrix_pop();
+  /* The immutable bounds used above are now eligible for input. This counter
+   * proves composition, not runtime visibility or physical headset delivery. */
+  card.drawn_generation = card.generation;
+}
+
+static bool task_poll(bContext *C)
+{
+  const wmWindowManager *wm = CTX_wm_manager(C);
+  return wm && wm->xr.runtime && WM_xr_session_is_ready(&wm->xr);
+}
+
+static bool task_history_availability_update(bContext *C, xr_task::State &card)
+{
+  const bool undo_available = WM_operator_name_poll(C, "XRWB_OT_history_undo");
+  const bool redo_available = WM_operator_name_poll(C, "XRWB_OT_history_redo");
+  const bool cancel_available = WM_operator_name_poll(C, "XRWB_OT_cancel_scene_edit");
+  const bool changed = card.undo_available != undo_available ||
+                       card.redo_available != redo_available ||
+                       card.cancel_available != cancel_available;
+  card.undo_available = undo_available;
+  card.redo_available = redo_available;
+  card.cancel_available = cancel_available;
+  return changed;
+}
+
+static wmOperatorStatus task_card_exec(bContext *C, wmOperator *op)
+{
+  wmXrRuntimeData &runtime = *CTX_wm_manager(C)->xr.runtime;
+  xr_task::State &card = runtime.task_card;
+  if (!RNA_boolean_get(op->ptr, "visible")) {
+    xr_task::cancel(card);
+    card.visible = false;
+    return OPERATOR_FINISHED;
+  }
+  if (card.captured_action || runtime.editor_surface.captured_button ||
+      !runtime.task_view_ready)
+  {
+    return OPERATOR_CANCELLED;
+  }
+  const float width = RNA_float_get(op->ptr, "width");
+  const float distance = RNA_float_get(op->ptr, "distance");
+  const float scale = runtime.session_state.prev_base_scale * runtime.session_state.viewer_scale;
+  if (!std::isfinite(width) || !std::isfinite(distance) || !std::isfinite(scale) || scale <= 0) {
+    return OPERATOR_CANCELLED;
+  }
+  const bool simulated = RNA_boolean_get(op->ptr, "allow_simulated_input");
+  const char *test_allow = std::getenv("XRWB_TASK_TEST_ALLOW");
+  if (simulated && (!test_allow || strcmp(test_allow, "1") != 0)) {
+    return OPERATOR_CANCELLED;
+  }
+  if (!simulated && !GHOST_XrSessionViewsValid(runtime.ghost_context)) {
+    return OPERATOR_CANCELLED;
+  }
+  if (!runtime.task_card_font_plus_one) {
+    const int font = BLF_load_default(true);
+    if (font < 0) {
+      return OPERATOR_CANCELLED;
+    }
+    runtime.task_card_font_plus_one = font + 1;
+  }
+  runtime.task_card_simulator = simulated;
+  if (simulated) {
+    printf("XR_WORKBENCH task_input=SIMULATOR optical_verified=0\n");
+  }
+  if (!card.visible || RNA_boolean_get(op->ptr, "recall")) {
+    runtime.task_card_pose = runtime.task_view_pose;
+    float forward[3] = {0, 0, -distance * scale};
+    mul_qt_v3(runtime.task_card_pose.orientation_quat, forward);
+    add_v3_v3(runtime.task_card_pose.position, forward);
+  }
+  runtime.task_card_width = width * scale;
+  if (!card.visible) {
+    card.arrange = false;
+  }
+  card.visible = true;
+  card.opacity_percent = card.opacity_percent ? card.opacity_percent : 85;
+  card.generation = task_next_generation();
+  card.drawn_generation = 0;
+  card.tool_actions_available = WM_operatortype_find("XRWB_OT_set_edit_tool", false) != nullptr;
+  card.add_available = WM_operator_name_poll(C, "XRWB_OT_add_cube");
+  task_history_availability_update(C, card);
+  xr_task::cancel(card);
+  WM_event_add_notifier(C, NC_WINDOW, nullptr);
+  return OPERATOR_FINISHED;
+}
+
+static int task_ray_target(wmXrRuntimeData &runtime, wmOperator *op)
+{
+  float origin[3], direction[3], inverse[4][4], model[4][4];
+  RNA_float_get_array(op->ptr, "ray_origin", origin);
+  RNA_float_get_array(op->ptr, "ray_direction", direction);
+  for (int i = 0; i < 3; i++) {
+    if (!std::isfinite(origin[i]) || !std::isfinite(direction[i])) {
+      return 0;
+    }
+  }
+  wm_xr_pose_to_mat(&runtime.task_card_pose, model);
+  if (!invert_m4_m4(inverse, model)) {
+    return 0;
+  }
+  mul_m4_v3(inverse, origin);
+  mul_mat3_m4_v3(inverse, direction);
+  if (origin[2] <= 0 || direction[2] >= -1e-6f || runtime.task_card_width <= 0) {
+    return 0;
+  }
+  const float t = -origin[2] / direction[2];
+  const float scale = 1000.0f / runtime.task_card_width;
+  return xr_task::hit(runtime.task_card,
+                      (origin[0] + t * direction[0]) * scale + 500,
+                      (origin[1] + t * direction[1]) * scale + 250);
+}
+
+static wmOperatorStatus task_event_exec(bContext *C, wmOperator *op)
+{
+  wmWindowManager *wm = CTX_wm_manager(C);
+  wmXrRuntimeData &runtime = *wm->xr.runtime;
+  xr_task::State &card = runtime.task_card;
+  const auto phase = xr_task::Phase(RNA_enum_get(op->ptr, "phase"));
+  const bool image_local = RNA_boolean_get(op->ptr, "image_local");
+  const int pointer = RNA_int_get(op->ptr, "pointer_id");
+  /* Camera pixels are deliberately image-local and never masquerade as a
+   * tracked world ray. This path is limited to the desktop simulator. */
+  if (image_local && (!runtime.task_card_simulator || pointer != 2)) {
+    return OPERATOR_CANCELLED;
+  }
+  if (phase != xr_task::Phase::Cancel && !runtime.task_card_simulator &&
+      (!GHOST_XrSessionIsFocused(runtime.ghost_context) ||
+       !GHOST_XrSessionViewsValid(runtime.ghost_context)))
+  {
+    xr_task::cancel(card);
+    return OPERATOR_CANCELLED;
+  }
+  if (phase != xr_task::Phase::Cancel && runtime.editor_surface.captured_button) {
+    return OPERATOR_CANCELLED;
+  }
+  if (phase == xr_task::Phase::Move && !card.captured_action) {
+    bool availability_changed = false;
+    if (card.arrange) {
+      const bool add_available = WM_operator_name_poll(C, "XRWB_OT_add_cube");
+      availability_changed = card.add_available != add_available;
+      card.add_available = add_available;
+    }
+    else {
+      availability_changed = task_history_availability_update(C, card);
+    }
+    if (availability_changed) {
+      card.generation = task_next_generation();
+      card.drawn_generation = 0;
+      xr_task::cancel(card);
+      WM_event_add_notifier(C, NC_WINDOW, nullptr);
+      return OPERATOR_CANCELLED;
+    }
+  }
+  const float image_x = RNA_float_get(op->ptr, "image_x");
+  const float image_y = RNA_float_get(op->ptr, "image_y");
+  int target = phase == xr_task::Phase::Cancel ? 0 :
+               image_local ? xr_task::hit(card, image_x, image_y) :
+                             task_ray_target(runtime, op);
+  if (RNA_boolean_get(op->ptr, "cancel_only") && target != 4 && target != 13) {
+    target = 0;
+    if (phase == xr_task::Phase::Move) {
+      card.neutral_mask &= ~(1u << RNA_int_get(op->ptr, "pointer_id"));
+    }
+  }
+  int activate;
+  const bool consumed = xr_task::route(card, phase, pointer,
+                                       RNA_int_get(op->ptr, "generation"), target, activate);
+  if (image_local && phase == xr_task::Phase::Move && consumed &&
+      std::isfinite(image_x) && std::isfinite(image_y) &&
+      image_x >= 0 && image_x <= 1000 && image_y >= 0 && image_y <= 500)
+  {
+    card.image_cursor_x = image_x;
+    card.image_cursor_y = image_y;
+    card.image_cursor_visible = true;
+  }
+  else if (image_local && phase == xr_task::Phase::Move) {
+    card.image_cursor_visible = false;
+  }
+  if (activate == 1) {
+    card.opacity_percent = card.opacity_percent == 85 ? 25 :
+                           card.opacity_percent == 25 ? 55 : 85;
+  }
+  if (activate == 3 || activate == 4) {
+    card.arrange = activate == 3;
+    card.tool_actions_available = WM_operatortype_find("XRWB_OT_set_edit_tool", false) != nullptr;
+    card.add_available = WM_operator_name_poll(C, "XRWB_OT_add_cube");
+    task_history_availability_update(C, card);
+    card.generation = task_next_generation();
+    card.drawn_generation = 0;
+  }
+  if (activate >= 5 && activate <= 8) {
+    if (!card.tool_actions_available ||
+        !WM_operatortype_find("XRWB_OT_set_edit_tool", false))
+    {
+      return OPERATOR_CANCELLED;
+    }
+    PointerRNA props = WM_operator_properties_create("XRWB_OT_set_edit_tool");
+    RNA_enum_set(&props, "tool", activate == 5 ? 0 : activate == 6 ? 1 :
+                                  activate == 8 ? 2 : 3);
+    const wmOperatorStatus result = WM_operator_name_call(
+        C, "XRWB_OT_set_edit_tool", wm::OpCallContext::ExecDefault, &props, nullptr);
+    WM_operator_properties_free(&props);
+    if (!(result & OPERATOR_FINISHED)) {
+      return OPERATOR_CANCELLED;
+    }
+  }
+  if (activate == 9) {
+    if (!WM_operator_name_poll(C, "XRWB_OT_add_cube") ||
+        !(WM_operator_name_call(C, "XRWB_OT_add_cube", wm::OpCallContext::ExecDefault,
+                                nullptr, nullptr) & OPERATOR_FINISHED))
+    {
+      return OPERATOR_CANCELLED;
+    }
+  }
+  if (activate == 13) {
+    if (!WM_operator_name_poll(C, "XRWB_OT_cancel_scene_edit") ||
+        !(WM_operator_name_call(C, "XRWB_OT_cancel_scene_edit", wm::OpCallContext::ExecDefault,
+                                nullptr, nullptr) & OPERATOR_FINISHED))
+    {
+      return OPERATOR_CANCELLED;
+    }
+    task_history_availability_update(C, card);
+    card.generation = task_next_generation();
+    card.drawn_generation = 0;
+    xr_task::cancel(card);
+    WM_event_add_notifier(C, NC_WINDOW, nullptr);
+    return OPERATOR_FINISHED;
+  }
+  if (activate == 11 || activate == 12) {
+    const char *operator_id = activate == 11 ? "XRWB_OT_history_undo" :
+                                               "XRWB_OT_history_redo";
+    if (!WM_operator_name_poll(C, operator_id) ||
+        !(WM_operator_name_call(C, operator_id, wm::OpCallContext::ExecDefault,
+                                nullptr, nullptr) & OPERATOR_FINISHED))
+    {
+      return OPERATOR_CANCELLED;
+    }
+    /* Undo can replace Blender data; resolve the live runtime again. */
+    wmWindowManager *current_wm = CTX_wm_manager(C);
+    if (current_wm && current_wm->xr.runtime) {
+      xr_task::State &current_card = current_wm->xr.runtime->task_card;
+      task_history_availability_update(C, current_card);
+      current_card.generation = task_next_generation();
+      current_card.drawn_generation = 0;
+      xr_task::cancel(current_card);
+    }
+    WM_event_add_notifier(C, NC_WINDOW, nullptr);
+    return OPERATOR_FINISHED;
+  }
+  if (activate == 2) {
+    /* This may immediately free runtime; do not access card/runtime afterward. */
+    wm_xr_session_toggle(wm, runtime.session_root_win, runtime.exit_fn);
+  }
+  WM_event_add_notifier(C, NC_WINDOW, nullptr);
+  return consumed ? OPERATOR_FINISHED : OPERATOR_CANCELLED;
+}
+
+/* A deliberate image-local pinch can activate this fixed non-spatial action.
+ * It carries no hand ray and cannot select or transform scene objects. */
+static wmOperatorStatus task_cycle_opacity_exec(bContext *C, wmOperator *op)
+{
+  wmXrRuntimeData &runtime = *CTX_wm_manager(C)->xr.runtime;
+  xr_task::State &card = runtime.task_card;
+  if (!card.visible || card.generation != RNA_int_get(op->ptr, "generation") ||
+      card.drawn_generation != card.generation || card.captured_action ||
+      runtime.editor_surface.captured_button ||
+      (!runtime.task_card_simulator && !wm_xr_ui_input_ready(&runtime)))
+  {
+    return OPERATOR_CANCELLED;
+  }
+  card.opacity_percent = card.opacity_percent == 85 ? 25 :
+                         card.opacity_percent == 25 ? 55 : 85;
+  WM_event_add_notifier(C, NC_WINDOW, nullptr);
+  return OPERATOR_FINISHED;
+}
+
+static void WM_OT_xr_task_card(wmOperatorType *ot)
+{
+  ot->name = "XR Native Task Card";
+  ot->idname = "WM_OT_xr_task_card";
+  ot->description = "Show source-native semantic session controls, without capturing a desktop";
+  ot->poll = task_poll;
+  ot->exec = task_card_exec;
+  RNA_def_boolean(ot->srna, "visible", true, "Visible", "Show the native session card");
+  RNA_def_boolean(ot->srna, "recall", true, "Recall", "Recall at the current viewer pose");
+  RNA_def_boolean(ot->srna, "allow_simulated_input", false, "Test Simulator",
+                   "Controlled tests only; requires XRWB_TASK_TEST_ALLOW=1, never optical evidence");
+  RNA_def_float(ot->srna, "width", xr_task::default_width, .3f, 2,
+                "Width", "Width in meters", .3f, 2);
+  RNA_def_float(ot->srna, "distance", xr_task::default_distance, .3f, 3,
+                "Distance", "Distance in meters", .3f, 3);
+}
+
+static void WM_OT_xr_task_card_event(wmOperatorType *ot)
+{
+  static const EnumPropertyItem phases[] = {
+      {0, "MOVE", 0, "Move", "Neutral hover or captured movement"},
+      {1, "PRESS", 0, "Press", "Capture an eligible current-generation control"},
+      {2, "RELEASE", 0, "Release", "Activate only the same captured control"},
+      {3, "CANCEL", 0, "Cancel", "Release capture without activation"},
+      {0, nullptr, 0, nullptr, nullptr},
+  };
+  ot->name = "XR Native Task Input";
+  ot->idname = "WM_OT_xr_task_card_event";
+  ot->description = "Route a qualified input intent to a matching native presentation generation";
+  ot->poll = task_poll;
+  ot->exec = task_event_exec;
+  RNA_def_enum(ot->srna, "phase", phases, 0, "Phase", "");
+  RNA_def_int(ot->srna, "generation", 0, 0, INT_MAX, "Generation", "Drawn layout generation", 0, INT_MAX);
+  RNA_def_int(ot->srna, "pointer_id", 0, 0, 2, "Pointer", "Single captured pointer identity", 0, 2);
+  RNA_def_boolean(ot->srna, "cancel_only", false, "Cancel Only",
+                  "Support-hand route may only open Session and activate Cancel Edit");
+  RNA_def_boolean(ot->srna, "image_local", false, "Image-local pointer",
+                  "Simulator-only camera-image card coordinates, never a world or scene ray");
+  RNA_def_float(ot->srna, "image_x", 0, -FLT_MAX, FLT_MAX,
+                "Image X", "Card-local horizontal coordinate", -1000, 2000);
+  RNA_def_float(ot->srna, "image_y", 0, -FLT_MAX, FLT_MAX,
+                "Image Y", "Card-local vertical coordinate", -1000, 1000);
+  RNA_def_float_vector(ot->srna, "ray_origin", 3, nullptr, -FLT_MAX, FLT_MAX,
+                        "Ray Origin", "World-space origin", -1000, 1000);
+  RNA_def_float_vector(ot->srna, "ray_direction", 3, nullptr, -FLT_MAX, FLT_MAX,
+                        "Ray Direction", "World-space direction", -1, 1);
+}
+
+static void WM_OT_xr_task_card_cycle_opacity(wmOperatorType *ot)
+{
+  ot->name = "Cycle XR Task Card Opacity";
+  ot->idname = "WM_OT_xr_task_card_cycle_opacity";
+  ot->description = "Activate the fixed panel-opacity action from a non-spatial gesture";
+  ot->poll = task_poll;
+  ot->exec = task_cycle_opacity_exec;
+  RNA_def_int(ot->srna, "generation", 0, 0, INT_MAX, "Generation",
+              "Composed task-card generation at gesture start", 0, INT_MAX);
+}
+
+void wm_xr_task_operatortypes_register()
+{
+  WM_operatortype_append(WM_OT_xr_task_card);
+  WM_operatortype_append(WM_OT_xr_task_card_event);
+  WM_operatortype_append(WM_OT_xr_task_card_cycle_opacity);
+}
+}  // namespace blender
